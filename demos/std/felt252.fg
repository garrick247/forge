}

// ---- felt_n_mont_cond_sub: bounded conditional subtract of P
//
// For 9-element input (8 limbs + cap) with the Montgomery analysis bound
// state_9 < 2*P, the conditional subtract preserves modular value:
//   result_val == state_9_input OR result_val + P == state_9_input
//
// This is one of two pieces needed for felt252_mul mod-P. The other is
// the chained-iteration mod-P preservation through felt_n_montgomery_reduce_v2
// (deferred research arc — Z3 can't auto-compose all 8 mont_iter_K_split
// aggregate invariants into a single mod-P claim, even with structural
// stepwise helpers or explicit witness threading).
//
// Standalone verification: 272s wall, proof_ok.


fn felt_n_montgomery_reduce_v2(
    m0:  u32, m1:  u32, m2:  u32, m3:  u32,
    m4:  u32, m5:  u32, m6:  u32, m7:  u32,
    m8:  u32, m9:  u32, m10: u32, m11: u32,
    m12: u32, m13: u32, m14: u32, m15: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32)
    ensures ((result.0 + result.1 * 4294967296u64 + result.2 * 4294967296u64 * 4294967296u64 + result.3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64) * (4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64)) % (STARK_N_LIMB0 + STARK_N_LIMB1 * 4294967296u64 + STARK_N_LIMB2 * 4294967296u64 * 4294967296u64 + STARK_N_LIMB3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_N_LIMB4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_N_LIMB5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_N_LIMB6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_N_LIMB7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64) == (m0 + m1 * 4294967296u64 + m2 * 4294967296u64 * 4294967296u64 + m3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + m4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + m5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + m6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + m7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + m8 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + m9 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 