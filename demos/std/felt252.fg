    let r7: u32 = if use_diff == 1u32 { r7d } else { t7_15 };

    (r0, r1, r2, r3, r4, r5, r6, r7)
}




// ---- felt252_mul: composed multiplication via Montgomery reduction --------
// Produces (a * b * R^-1) mod P where R = 2^256. For canonical multiplication
// (a * b mod P), inputs and output are interpreted in Montgomery form (each
// canonical value v represented as v*R mod P). Converting in/out of
// Montgomery form is felt252_to_mont / felt252_from_mont, deferred.

fn felt252_mul(
    a0: u32, a1: u32, a2: u32, a3: u32,
    a4: u32, a5: u32, a6: u32, a7: u32,
    b0: u32, b1: u32, b2: u32, b3: u32,
    b4: u32, b5: u32, b6: u32, b7: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32)
{
    let (p0, p1, p2,  p3,  p4,  p5,  p6,  p7,
         p8, p9, p10, p11, p12, p13, p14, p15) =
        felt252_mul_raw(a0, a1, a2, a3, a4, a5, a6, a7,
                        b0, b1, b2, b3, b4, b5, b6, b7);
    felt252_montgomery_reduce(p0, p1, p2,  p3,  p4,  p5,  p6,  p7,
                              p8, p9, p10, p11, p12, p13, p14, p15)
}



// ---- felt252_sqr: squaring as a degenerate multiplication ----------------
// felt252_sqr(a) == felt252_mul(a, a). A specialised squaring kernel would
// halve the partial-product count (you only need p_ij for i <= j and
// double the off-diagonal terms), but the proof structure is identical
// and the schoolbook composition is fast to verify, so we keep it as a
// thin wrapper for now.

fn felt252_sqr(
    a0: u32, a1: u32, a2: u32, a3: u32,
    a4: u32, a5: u32, a6: u32, a7: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32)
{
    felt252_mul(a0, a1, a2, a3, a4, a5, a6, a7,
                a0, a1, a2, a3, a4, a5, a6, a7)
}

// ---- felt252_inv: modular inverse via square-and-multiply ----------
// a^(P-2) mod P. Generated by gen_felt252_inv.py — do not hand-edit;
// regenerate the body from the canonical bit pattern of (P-2) if the
// prime changes. Calls felt252_sqr and felt252_mul; both have empty
// contracts so this function emits zero new proof obligations.
//
// MSB at bit 251; iterate bits 250..0. 251 squarings + 193 multiplies.

fn felt252_inv(
    a0: u32, a1: u32, a2: u32, a3: u32,
    a4: u32, a5: u32, a6: u32, a7: u32
