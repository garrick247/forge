    let new_t5: u32 = new_t5_u64 as u32;
    let k6: u64 = acc5 / 4294967296u64;
    let acc6: u64 = (t6 as u64) + k6;
    let new_t6_u64: u64 = acc6 % 4294967296u64;
    let new_t6: u32 = new_t6_u64 as u32;
    let k7: u64 = acc6 / 4294967296u64;
    let acc7: u64 = (t7 as u64) + k7;
    let new_t7_u64: u64 = acc7 % 4294967296u64;
    let new_t7: u32 = new_t7_u64 as u32;
    let k8: u64 = acc7 / 4294967296u64;
    let acc8: u64 = (t8 as u64) + k8;
    let new_t8_u64: u64 = acc8 % 4294967296u64;
    let new_t8: u32 = new_t8_u64 as u32;
    let k9: u64 = acc8 / 4294967296u64;
    let acc9: u64 = (t9 as u64) + k9;
    let new_t9_u64: u64 = acc9 % 4294967296u64;
    let new_t9: u32 = new_t9_u64 as u32;
    let k10: u64 = acc9 / 4294967296u64;
    let acc10: u64 = (t10 as u64) + k10;
    let new_t10_u64: u64 = acc10 % 4294967296u64;
    let new_t10: u32 = new_t10_u64 as u32;
    let k11: u64 = acc10 / 4294967296u64;
    let acc11: u64 = (t11 as u64) + (m17_lo as u64) + k11;
    let new_t11_u64: u64 = acc11 % 4294967296u64;
    let new_t11: u32 = new_t11_u64 as u32;
    let k12: u64 = acc11 / 4294967296u64;
    let acc12: u64 = (t12 as u64) + (m17_hi as u64) + (mpow_lo as u64) + k12;
    let new_t12_u64: u64 = acc12 % 4294967296u64;
    let new_t12: u32 = new_t12_u64 as u32;
    let k13: u64 = acc12 / 4294967296u64;
    let acc13: u64 = (t13 as u64) + (mpow_hi as u64) + k13;
    let new_t13_u64: u64 = acc13 % 4294967296u64;
    let new_t13: u32 = new_t13_u64 as u32;
    let k14: u64 = acc13 / 4294967296u64;
    let acc14: u64 = (t14 as u64) + k14;
    let new_t14_u64: u64 = acc14 % 4294967296u64;
    let new_t14: u32 = new_t14_u64 as u32;
    let k15: u64 = acc14 / 4294967296u64;
    let acc15: u64 = (t15 as u64) + k15 + cap_in;
    let new_t15_u64: u64 = acc15 % 4294967296u64;
    let new_t15: u32 = new_t15_u64 as u32;
    let cap_out: u64 = acc15 / 4294967296u64;
    (new_t0,  new_t1,  new_t2,  new_t3,
     new_t4,  new_t5,  new_t6,  new_t7,
     new_t8,  new_t9,  new_t10, new_t11,
     new_t12, new_t13, new_t14, new_t15, cap_out)
