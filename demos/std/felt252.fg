const STARK_BETA_LIMB5: u32 = 353261933u32;  // 0x150E596D
const STARK_BETA_LIMB6: u32 = 4022223070u32;  // 0xEFBE40DE
const STARK_BETA_LIMB7: u32 = 116528147u32;  // 0x06F21413

