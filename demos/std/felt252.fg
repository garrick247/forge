// Montgomery iteration 6: zeroes out limb 6.
fn mont_iter_6(
    t0:  u32, t1:  u32, t2:  u32, t3:  u32,
    t4:  u32, t5:  u32, t6:  u32, t7:  u32,
    t8:  u32, t9:  u32, t10: u32, t11: u32,
    t12: u32, t13: u32, t14: u32, t15: u32,
    cap_in: u64
) -> (u32, u32, u32, u32, u32, u32, u32, u32,
      u32, u32, u32, u32, u32, u32, u32, u32, u64)
    requires cap_in <= 1u64
    ensures result.6 == 0u32
    ensures result.16 <= 1u64
