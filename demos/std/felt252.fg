const POSEIDON_MDS_02_1: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_02_2: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_02_3: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_02_4: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_02_5: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_02_6: u32 = 4294966768u32;  // 0xFFFFFDF0
const POSEIDON_MDS_02_7: u32 = 134217727u32;  // 0x07FFFFFF

// MDS[1][0] canonical = 1
const POSEIDON_MDS_10_0: u32 = 4294967265u32;  // 0xFFFFFFE1
const POSEIDON_MDS_10_1: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_10_2: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_10_3: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_10_4: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_10_5: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_10_6: u32 = 4294966768u32;  // 0xFFFFFDF0
const POSEIDON_MDS_10_7: u32 = 134217727u32;  // 0x07FFFFFF

// MDS[1][1] canonical = 3618502788666131213697322783095070105623107215331596699973092056135872020480
const POSEIDON_MDS_11_0: u32 = 32u32;  // 0x00000020
const POSEIDON_MDS_11_1: u32 = 0u32;  // 0x00000000
const POSEIDON_MDS_11_2: u32 = 0u32;  // 0x00000000
const POSEIDON_MDS_11_3: u32 = 0u32;  // 0x00000000
const POSEIDON_MDS_11_4: u32 = 0u32;  // 0x00000000
const POSEIDON_MDS_11_5: u32 = 0u32;  // 0x00000000
const POSEIDON_MDS_11_6: u32 = 544u32;  // 0x00000220
const POSEIDON_MDS_11_7: u32 = 0u32;  // 0x00000000

// MDS[1][2] canonical = 1
