// ---- poseidon_chain_demo: 2 full + 2 partial rounds chained ------------
// Demonstrates that the Phase 1 round functions compose correctly through
// repeated invocation with different round constants. Each call site is
// just a Forge function call — verified once at definition time.
//
// Real Stark Poseidon would chain 91 rounds (4 full + 83 partial + 4
// full) with canonical round constants; this is the proof-of-concept.

fn poseidon_chain_demo(
    in0_0: u32, in0_1: u32, in0_2: u32, in0_3: u32, in0_4: u32, in0_5: u32, in0_6: u32, in0_7: u32,
    in1_0: u32, in1_1: u32, in1_2: u32, in1_3: u32, in1_4: u32, in1_5: u32, in1_6: u32, in1_7: u32,
    in2_0: u32, in2_1: u32, in2_2: u32, in2_3: u32, in2_4: u32, in2_5: u32, in2_6: u32, in2_7: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32,
      u32, u32, u32, u32, u32, u32, u32, u32,
      u32, u32, u32, u32, u32, u32, u32, u32)
{
    let (r1_s0_0, r1_s0_1, r1_s0_2, r1_s0_3, r1_s0_4, r1_s0_5, r1_s0_6, r1_s0_7, r1_s1_0, r1_s1_1, r1_s1_2, r1_s1_3, r1_s1_4, r1_s1_5, r1_s1_6, r1_s1_7, r1_s2_0, r1_s2_1, r1_s2_2, r1_s2_3, r1_s2_4, r1_s2_5, r1_s2_6, r1_s2_7) =
        poseidon_full_round(
            in0_0, in0_1, in0_2, in0_3, in0_4, in0_5, in0_6, in0_7,
            in1_0, in1_1, in1_2, in1_3, in1_4, in1_5, in1_6, in1_7,
            in2_0, in2_1, in2_2, in2_3, in2_4, in2_5, in2_6, in2_7,
            POSEIDON_RC_00_0, POSEIDON_RC_00_1, POSEIDON_RC_00_2, POSEIDON_RC_00_3, POSEIDON_RC_00_4, POSEIDON_RC_00_5, POSEIDON_RC_00_6, POSEIDON_RC_00_7,
            POSEIDON_RC_01_0, POSEIDON_RC_01_1, POSEIDON_RC_01_2, POSEIDON_RC_01_3, POSEIDON_RC_01_4, POSEIDON_RC_01_5, POSEIDON_RC_01_6, POSEIDON_RC_01_7,
            POSEIDON_RC_02_0, POSEIDON_RC_02_1, POSEIDON_RC_02_2, POSEIDON_RC_02_3, POSEIDON_RC_02_4, POSEIDON_RC_02_5, POSEIDON_RC_02_6, POSEIDON_RC_02_7);

    let (r2_s0_0, r2_s0_1, r2_s0_2, r2_s0_3, r2_s0_4, r2_s0_5, r2_s0_6, r2_s0_7, r2_s1_0, r2_s1_1, r2_s1_2, r2_s1_3, r2_s1_4, r2_s1_5, r2_s1_6, r2_s1_7, r2_s2_0, r2_s2_1, r2_s2_2, r2_s2_3, r2_s2_4, r2_s2_5, r2_s2_6, r2_s2_7) =
        poseidon_full_round(
            r1_s0_0, r1_s0_1, r1_s0_2, r1_s0_3, r1_s0_4, r1_s0_5, r1_s0_6, r1_s0_7,
            r1_s1_0, r1_s1_1, r1_s1_2, r1_s1_3, r1_s1_4, r1_s1_5, r1_s1_6, r1_s1_7,
            r1_s2_0, r1_s2_1, r1_s2_2, r1_s2_3, r1_s2_4, r1_s2_5, r1_s2_6, r1_s2_7,
            POSEIDON_RC_10_0, POSEIDON_RC_10_1, POSEIDON_RC_10_2, POSEIDON_RC_10_3, POSEIDON_RC_10_4, POSEIDON_RC_10_5, POSEIDON_RC_10_6, POSEIDON_RC_10_7,
            POSEIDON_RC_11_0, POSEIDON_RC_11_1, POSEIDON_RC_11_2, POSEIDON_RC_11_3, POSEIDON_RC_11_4, POSEIDON_RC_11_5, POSEIDON_RC_11_6, POSEIDON_RC_11_7,
            POSEIDON_RC_12_0, POSEIDON_RC_12_1, POSEIDON_RC_12_2, POSEIDON_RC_12_3, POSEIDON_RC_12_4, POSEIDON_RC_12_5, POSEIDON_RC_12_6, POSEIDON_RC_12_7);

    let (r3_s0_0, r3_s0_1, r3_s0_2, r3_s0_3, r3_s0_4, r3_s0_5, r3_s0_6, r3_s0_7, r3_s1_0, r3_s1_1, r3_s1_2, r3_s1_3, r3_s1_4, r3_s1_5, r3_s1_6, r3_s1_7, r3_s2_0, r3_s2_1, r3_s2_2, r3_s2_3, r3_s2_4, r3_s2_5, r3_s2_6, r3_s2_7) =
        poseidon_partial_round(
            r2_s0_0, r2_s0_1, r2_s0_2, r2_s0_3, r2_s0_4, r2_s0_5, r2_s0_6, r2_s0_7,
            r2_s1_0, r2_s1_1, r2_s1_2, r2_s1_3, r2_s1_4, r2_s1_5, r2_s1_6, r2_s1_7,
            r2_s2_0, r2_s2_1, r2_s2_2, r2_s2_3, r2_s2_4, r2_s2_5, r2_s2_6, r2_s2_7,
            POSEIDON_RC_20_0, POSEIDON_RC_20_1, POSEIDON_RC_20_2, POSEIDON_RC_20_3, POSEIDON_RC_20_4, POSEIDON_RC_20_5, POSEIDON_RC_20_6, POSEIDON_RC_20_7,
            POSEIDON_RC_21_0, POSEIDON_RC_21_1, POSEIDON_RC_21_2, POSEIDON_RC_21_3, POSEIDON_RC_21_4, POSEIDON_RC_21_5, POSEIDON_RC_21_6, POSEIDON_RC_21_7,
            POSEIDON_RC_22_0, POSEIDON_RC_22_1, POSEIDON_RC_22_2, POSEIDON_RC_22_3, POSEIDON_RC_22_4, POSEIDON_RC_22_5, POSEIDON_RC_22_6, POSEIDON_RC_22_7);

    let (r4_s0_0, r4_s0_1, r4_s0_2, r4_s0_3, r4_s0_4, r4_s0_5, r4_s0_6, r4_s0_7, r4_s1_0, r4_s1_1, r4_s1_2, r4_s1_3, r4_s1_4, r4_s1_5, r4_s1_6, r4_s1_7, r4_s2_0, r4_s2_1, r4_s2_2, r4_s2_3, r4_s2_4, r4_s2_5, r4_s2_6, r4_s2_7) =
        poseidon_partial_round(
            r3_s0_0, r3_s0_1, r3_s0_2, r3_s0_3, r3_s0_4, r3_s0_5, r3_s0_6, r3_s0_7,
            r3_s1_0, r3_s1_1, r3_s1_2, r3_s1_3, r3_s1_4, r3_s1_5, r3_s1_6, r3_s1_7,
            r3_s2_0, r3_s2_1, r3_s2_2, r3_s2_3, r3_s2_4, r3_s2_5, r3_s2_6, r3_s2_7,
            POSEIDON_RC_30_0, POSEIDON_RC_30_1, POSEIDON_RC_30_2, POSEIDON_RC_30_3, POSEIDON_RC_30_4, POSEIDON_RC_30_5, POSEIDON_RC_30_6, POSEIDON_RC_30_7,
            POSEIDON_RC_31_0, POSEIDON_RC_31_1, POSEIDON_RC_31_2, POSEIDON_RC_31_3, POSEIDON_RC_31_4, POSEIDON_RC_31_5, POSEIDON_RC_31_6, POSEIDON_RC_31_7,
            POSEIDON_RC_32_0, POSEIDON_RC_32_1, POSEIDON_RC_32_2, POSEIDON_RC_32_3, POSEIDON_RC_32_4, POSEIDON_RC_32_5, POSEIDON_RC_32_6, POSEIDON_RC_32_7);

    (r4_s0_0, r4_s0_1, r4_s0_2, r4_s0_3, r4_s0_4, r4_s0_5, r4_s0_6, r4_s0_7, r4_s1_0, r4_s1_1, r4_s1_2, r4_s1_3, r4_s1_4, r4_s1_5, r4_s1_6, r4_s1_7, r4_s2_0, r4_s2_1, r4_s2_2, r4_s2_3, r4_s2_4, r4_s2_5, r4_s2_6, r4_s2_7)
}

