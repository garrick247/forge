    let f0e: u64 = (t4_14 as u64) + k5e;
    let t5_14_u64: u64 = f0e % 4294967296u64;
    let t5_14: u32 = t5_14_u64 as u32;
    let k5f: u64 = f0e / 4294967296u64;
    let f0f: u64 = (t4_15 as u64) + cap4 + k5f;
    let t5_15_u64: u64 = f0f % 4294967296u64;
    let t5_15: u32 = t5_15_u64 as u32;
    let cap5: u64 = f0f / 4294967296u64;

    // ===== Iteration 6: zero out t5_6, touches limbs 6..14 =====
    let n6: u32 = ((t5_6 as u64) * 4294967295u64) as u32;
    let n6_17: u64 = (n6 as u64) * 17u64;
    let n6_17_lo_u64: u64 = n6_17 % 4294967296u64;
    let n6_17_lo: u32 = n6_17_lo_u64 as u32;
    let n6_17_hi: u32 = (n6_17 / 4294967296u64) as u32;
    let n6_pow: u64 = (n6 as u64) * 134217728u64;
    let n6_pow_lo_u64: u64 = n6_pow % 4294967296u64;
    let n6_pow_lo: u32 = n6_pow_lo_u64 as u32;
    let n6_pow_hi: u32 = (n6_pow / 4294967296u64) as u32;

    let g06: u64 = (t5_6 as u64) + (n6 as u64);
    let k67: u64 = g06 / 4294967296u64;
    let g07: u64 = (t5_7 as u64) + k67;
    let t6_7_u64: u64 = g07 % 4294967296u64;
    let t6_7: u32 = t6_7_u64 as u32;
    let k68: u64 = g07 / 4294967296u64;
    let g08: u64 = (t5_8 as u64) + k68;
    let t6_8_u64: u64 = g08 % 4294967296u64;
    let t6_8: u32 = t6_8_u64 as u32;
    let k69: u64 = g08 / 4294967296u64;
    let g09: u64 = (t5_9 as u64) + k69;
    let t6_9_u64: u64 = g09 % 4294967296u64;
    let t6_9: u32 = t6_9_u64 as u32;
    let k6a: u64 = g09 / 4294967296u64;
    let g0a: u64 = (t5_10 as u64) + k6a;
    let t6_10_u64: u64 = g0a % 4294967296u64;
    let t6_10: u32 = t6_10_u64 as u32;
    let k6b: u64 = g0a / 4294967296u64;
    let g0b: u64 = (t5_11 as u64) + k6b;
    let t6_11_u64: u64 = g0b % 4294967296u64;
    let t6_11: u32 = t6_11_u64 as u32;
    let k6c: u64 = g0b / 4294967296u64;
    let g0c: u64 = (t5_12 as u64) + (n6_17_lo as u64) + k6c;
    let t6_12_u64: u64 = g0c % 4294967296u64;
    let t6_12: u32 = t6_12_u64 as u32;
    let k6d: u64 = g0c / 4294967296u64;
    let g0d: u64 = (t5_13 as u64) + (n6_17_hi as u64) + (n6_pow_lo as u64) + k6d;
    let t6_13_u64: u64 = g0d % 4294967296u64;
    let t6_13: u32 = t6_13_u64 as u32;
    let k6e: u64 = g0d / 4294967296u64;
    let g0e: u64 = (t5_14 as u64) + (n6_pow_hi as u64) + k6e;
    let t6_14_u64: u64 = g0e % 4294967296u64;
    let t6_14: u32 = t6_14_u64 as u32;
    let k6f: u64 = g0e / 4294967296u64;
    let g0f: u64 = (t5_15 as u64) + cap5 + k6f;
    let t6_15_u64: u64 = g0f % 4294967296u64;
    let t6_15: u32 = t6_15_u64 as u32;
    let cap6: u64 = g0f / 4294967296u64;

    // ===== Iteration 7: zero out t6_7, touches limbs 7..15 =====
    let n7: u32 = ((t6_7 as u64) * 4294967295u64) as u32;
    let n7_17: u64 = (n7 as u64) * 17u64;
    let n7_17_lo_u64: u64 = n7_17 % 4294967296u64;
    let n7_17_lo: u32 = n7_17_lo_u64 as u32;
    let n7_17_hi: u32 = (n7_17 / 4294967296u64) as u32;
    let n7_pow: u64 = (n7 as u64) * 134217728u64;
    let n7_pow_lo_u64: u64 = n7_pow % 4294967296u64;
    let n7_pow_lo: u32 = n7_pow_lo_u64 as u32;
    let n7_pow_hi: u32 = (n7_pow / 4294967296u64) as u32;

    let h07: u64 = (t6_7 as u64) + (n7 as u64);
    let k78: u64 = h07 / 4294967296u64;
    let h08: u64 = (t6_8 as u64) + k78;
    let t7_8_u64: u64 = h08 % 4294967296u64;
    let t7_8: u32 = t7_8_u64 as u32;
    let k79: u64 = h08 / 4294967296u64;
    let h09: u64 = (t6_9 as u64) + k79;
    let t7_9_u64: u64 = h09 % 4294967296u64;
    let t7_9: u32 = t7_9_u64 as u32;
    let k7a: u64 = h09 / 4294967296u64;
    let h0a: u64 = (t6_10 as u64) + k7a;
    let t7_10_u64: u64 = h0a % 4294967296u64;
    let t7_10: u32 = t7_10_u64 as u32;
    let k7b: u64 = h0a / 4294967296u64;
    let h0b: u64 = (t6_11 as u64) + k7b;
    let t7_11_u64: u64 = h0b % 4294967296u64;
    let t7_11: u32 = t7_11_u64 as u32;
    let k7c: u64 = h0b / 4294967296u64;
    let h0c: u64 = (t6_12 as u64) + k7c;
    let t7_12_u64: u64 = h0c % 4294967296u64;
    let t7_12: u32 = t7_12_u64 as u32;
    let k7d: u64 = h0c / 4294967296u64;
    let h0d: u64 = (t6_13 as u64) + (n7_17_lo as u64) + k7d;
    let t7_13_u64: u64 = h0d % 4294967296u64;
    let t7_13: u32 = t7_13_u64 as u32;
    let k7e: u64 = h0d / 4294967296u64;
    let h0e: u64 = (t6_14 as u64) + (n7_17_hi as u64) + (n7_pow_lo as u64) + k7e;
    let t7_14_u64: u64 = h0e % 4294967296u64;
    let t7_14: u32 = t7_14_u64 as u32;
    let k7f: u64 = h0e / 4294967296u64;
    let h0f: u64 = (t6_15 as u64) + (n7_pow_hi as u64) + cap6 + k7f;
    let t7_15_u64: u64 = h0f % 4294967296u64;
    let t7_15: u32 = t7_15_u64 as u32;
    // cap7 = h0f / 4294967296u64 — final overflow bit. In CIOS Montgomery the
    // intermediate value is < 2P*R, so after the >>R shift the result is
    // < 2P, and cap7 ∈ {0, 1} acts as the "high bit" beyond limb 15.

    // ===== Conditional subtract P =====
    // The 8-limb candidate result is (t7_8..t7_15). Tentatively compute
    // (candidate - P) via the borrow chain; use the diff if the candidate
    // was >= P (i.e., the subtract didn't underflow), else keep candidate.

    let r0d: u32 = sub_with_borrow_diff(t7_8,  STARK_P_LIMB0, 0u32);
    let rb0: u32 = sub_with_borrow_out (t7_8,  STARK_P_LIMB0, 0u32);
    let r1d: u32 = sub_with_borrow_diff(t7_9,  STARK_P_LIMB1, rb0);
    let rb1: u32 = sub_with_borrow_out (t7_9,  STARK_P_LIMB1, rb0);
    let r2d: u32 = sub_with_borrow_diff(t7_10, STARK_P_LIMB2, rb1);
    let rb2: u32 = sub_with_borrow_out (t7_10, STARK_P_LIMB2, rb1);
    let r3d: u32 = sub_with_borrow_diff(t7_11, STARK_P_LIMB3, rb2);
    let rb3: u32 = sub_with_borrow_out (t7_11, STARK_P_LIMB3, rb2);
    let r4d: u32 = sub_with_borrow_diff(t7_12, STARK_P_LIMB4, rb3);
    let rb4: u32 = sub_with_borrow_out (t7_12, STARK_P_LIMB4, rb3);
    let r5d: u32 = sub_with_borrow_diff(t7_13, STARK_P_LIMB5, rb4);
    let rb5: u32 = sub_with_borrow_out (t7_13, STARK_P_LIMB5, rb4);
    let r6d: u32 = sub_with_borrow_diff(t7_14, STARK_P_LIMB6, rb5);
    let rb6: u32 = sub_with_borrow_out (t7_14, STARK_P_LIMB6, rb5);
    let r7d: u32 = sub_with_borrow_diff(t7_15, STARK_P_LIMB7, rb6);
    let rb7: u32 = sub_with_borrow_out (t7_15, STARK_P_LIMB7, rb6);

    // Use the diff when (cap7 carry was set) OR (subtract didn't underflow).
    // cap7 is just (h0f / 4294967296u64); compute it inline to avoid an unused-warn.
    let cap7: u64 = h0f / 4294967296u64;
    let use_diff: u32 = if cap7 >= 1u64 {
        1u32
    } else {
        if rb7 == 0u32 { 1u32 } else { 0u32 }
    };

    let r0: u32 = if use_diff == 1u32 { r0d } else { t7_8  };
    let r1: u32 = if use_diff == 1u32 { r1d } else { t7_9  };
    let r2: u32 = if use_diff == 1u32 { r2d } else { t7_10 };
    let r3: u32 = if use_diff == 1u32 { r3d } else { t7_11 };
    let r4: u32 = if use_diff == 1u32 { r4d } else { t7_12 };
    let r5: u32 = if use_diff == 1u32 { r5d } else { t7_13 };
    let r6: u32 = if use_diff == 1u32 { r6d } else { t7_14 };
    let r7: u32 = if use_diff == 1u32 { r7d } else { t7_15 };

    (r0, r1, r2, r3, r4, r5, r6, r7)
}




// ---- felt252_mul: composed multiplication via Montgomery reduction --------
// Produces (a * b * R^-1) mod P where R = 2^256. For canonical multiplication
// (a * b mod P), inputs and output are interpreted in Montgomery form (each
// canonical value v represented as v*R mod P). Converting in/out of
// Montgomery form is felt252_to_mont / felt252_from_mont, deferred.

fn felt252_mul(
    a0: u32, a1: u32, a2: u32, a3: u32,
    a4: u32, a5: u32, a6: u32, a7: u32,
    b0: u32, b1: u32, b2: u32, b3: u32,
    b4: u32, b5: u32, b6: u32, b7: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32)
    ensures ((result.0 + result.1 * 4294967296u64 + result.2 * 4294967296u64 * 4294967296u64 + result.3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64) * (4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64)) % (STARK_P_LIMB0 + STARK_P_LIMB1 * 4294967296u64 + STARK_P_LIMB2 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64) == ((a0 + a1 * 4294967296u64 + a2 * 4294967296u64 * 4294967296u64 + a3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64) * (b0 + b1 * 4294967296u64 + b2 * 4294967296u64 * 4294967296u64 + b3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + b4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + b5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + b6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + b7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64)) % (STARK_P_LIMB0 + STARK_P_LIMB1 * 4294967296u64 + STARK_P_LIMB2 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64)
    ensures (result.0 + result.1 * 4294967296u64 + result.2 * 4294967296u64 * 4294967296u64 + result.3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64) < (STARK_P_LIMB0 + STARK_P_LIMB1 * 4294967296u64 + STARK_P_LIMB2 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64)
{
    let (p0, p1, p2,  p3,  p4,  p5,  p6,  p7,
         p8, p9, p10, p11, p12, p13, p14, p15) =
        felt252_mul_raw(a0, a1, a2, a3, a4, a5, a6, a7,
                        b0, b1, b2, b3, b4, b5, b6, b7);
    felt252_montgomery_reduce_v2(p0, p1, p2,  p3,  p4,  p5,  p6,  p7,
                                 p8, p9, p10, p11, p12, p13, p14, p15)
}



// ---- felt252_sqr: squaring as a degenerate multiplication ----------------
// felt252_sqr(a) == felt252_mul(a, a). A specialised squaring kernel would
// halve the partial-product count (you only need p_ij for i <= j and
// double the off-diagonal terms), but the proof structure is identical
// and the schoolbook composition is fast to verify, so we keep it as a
// thin wrapper for now.

fn felt252_sqr(
    a0: u32, a1: u32, a2: u32, a3: u32,
    a4: u32, a5: u32, a6: u32, a7: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32)
    ensures ((result.0 + result.1 * 4294967296u64 + result.2 * 4294967296u64 * 4294967296u64 + result.3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64) * (4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64)) % (STARK_P_LIMB0 + STARK_P_LIMB1 * 4294967296u64 + STARK_P_LIMB2 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64) == ((a0 + a1 * 4294967296u64 + a2 * 4294967296u64 * 4294967296u64 + a3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64) * (a0 + a1 * 4294967296u64 + a2 * 4294967296u64 * 4294967296u64 + a3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64)) % (STARK_P_LIMB0 + STARK_P_LIMB1 * 4294967296u64 + STARK_P_LIMB2 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64)
    ensures (result.0 + result.1 * 4294967296u64 + result.2 * 4294967296u64 * 4294967296u64 + result.3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64) < (STARK_P_LIMB0 + STARK_P_LIMB1 * 4294967296u64 + STARK_P_LIMB2 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64)
{
    felt252_mul(a0, a1, a2, a3, a4, a5, a6, a7,
                a0, a1, a2, a3, a4, a5, a6, a7)
}

// ---- felt252_inv: modular inverse via square-and-multiply ----------
// a^(P-2) mod P. Generated by gen_felt252_inv.py — do not hand-edit;
// regenerate the body from the canonical bit pattern of (P-2) if the
// prime changes. Calls felt252_sqr and felt252_mul; both have empty
// contracts so this function emits zero new proof obligations.
//
// MSB at bit 251; iterate bits 250..0. 251 squarings + 193 multiplies.

