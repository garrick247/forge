// ---- felt252_mul_raw: schoolbook 8x8 -> 16-limb product (no reduction) ----
// Computes a * b as a 16-limb (512-bit) integer. Modular reduction to fit
// back into 8 limbs mod P is deferred to felt252_reduce_512 (uses Solinas
// folding via 2^251 == -17*2^192 - 1 mod P).
//
// Strategy: 64 partial products p_ij = a_i * b_j as u64. Each contributes
// its low 32 bits to output limb (i+j) and its high 32 bits to limb (i+j+1).
// Accumulate per-limb in a u64; the carry between limbs is bounded (~16
// u32 contributions per middle limb, sum well within u64).

fn felt252_mul_raw(
    a0: u32, a1: u32, a2: u32, a3: u32,
    a4: u32, a5: u32, a6: u32, a7: u32,
    b0: u32, b1: u32, b2: u32, b3: u32,
    b4: u32, b5: u32, b6: u32, b7: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32,
      u32, u32, u32, u32, u32, u32, u32, u32)
    ensures (result.0 + result.1 * 4294967296u64 + result.2 * 4294967296u64 * 4294967296u64 + result.3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.8 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.9 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.10 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.11 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.12 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.13 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.14 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.15 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64) == (a0 + a1 * 4294967296u64 + a2 * 4294967296u64 * 4294967296u64 + a3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64) * (b0 + b1 * 4294967296u64 + b2 * 4294967296u64 * 4294967296u64 + b3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + b4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + b5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + b6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + b7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64)
{
    // 64 partial products as u64
    let p00: u64 = (a0 as u64) * (b0 as u64);
    let p01: u64 = (a0 as u64) * (b1 as u64);
    let p02: u64 = (a0 as u64) * (b2 as u64);
    let p03: u64 = (a0 as u64) * (b3 as u64);
    let p04: u64 = (a0 as u64) * (b4 as u64);
    let p05: u64 = (a0 as u64) * (b5 as u64);
    let p06: u64 = (a0 as u64) * (b6 as u64);
    let p07: u64 = (a0 as u64) * (b7 as u64);

    let p10: u64 = (a1 as u64) * (b0 as u64);
    let p11: u64 = (a1 as u64) * (b1 as u64);
    let p12: u64 = (a1 as u64) * (b2 as u64);
    let p13: u64 = (a1 as u64) * (b3 as u64);
    let p14: u64 = (a1 as u64) * (b4 as u64);
    let p15: u64 = (a1 as u64) * (b5 as u64);
    let p16: u64 = (a1 as u64) * (b6 as u64);
    let p17: u64 = (a1 as u64) * (b7 as u64);

    let p20: u64 = (a2 as u64) * (b0 as u64);
    let p21: u64 = (a2 as u64) * (b1 as u64);
    let p22: u64 = (a2 as u64) * (b2 as u64);
    let p23: u64 = (a2 as u64) * (b3 as u64);
    let p24: u64 = (a2 as u64) * (b4 as u64);
    let p25: u64 = (a2 as u64) * (b5 as u64);
    let p26: u64 = (a2 as u64) * (b6 as u64);
    let p27: u64 = (a2 as u64) * (b7 as u64);

    let p30: u64 = (a3 as u64) * (b0 as u64);
    let p31: u64 = (a3 as u64) * (b1 as u64);
    let p32: u64 = (a3 as u64) * (b2 as u64);
    let p33: u64 = (a3 as u64) * (b3 as u64);
    let p34: u64 = (a3 as u64) * (b4 as u64);
    let p35: u64 = (a3 as u64) * (b5 as u64);
    let p36: u64 = (a3 as u64) * (b6 as u64);
    let p37: u64 = (a3 as u64) * (b7 as u64);

    let p40: u64 = (a4 as u64) * (b0 as u64);
    let p41: u64 = (a4 as u64) * (b1 as u64);
    let p42: u64 = (a4 as u64) * (b2 as u64);
    let p43: u64 = (a4 as u64) * (b3 as u64);
    let p44: u64 = (a4 as u64) * (b4 as u64);
    let p45: u64 = (a4 as u64) * (b5 as u64);
    let p46: u64 = (a4 as u64) * (b6 as u64);
    let p47: u64 = (a4 as u64) * (b7 as u64);

    let p50: u64 = (a5 as u64) * (b0 as u64);
    let p51: u64 = (a5 as u64) * (b1 as u64);
    let p52: u64 = (a5 as u64) * (b2 as u64);
    let p53: u64 = (a5 as u64) * (b3 as u64);
    let p54: u64 = (a5 as u64) * (b4 as u64);
    let p55: u64 = (a5 as u64) * (b5 as u64);
    let p56: u64 = (a5 as u64) * (b6 as u64);
    let p57: u64 = (a5 as u64) * (b7 as u64);

    let p60: u64 = (a6 as u64) * (b0 as u64);
    let p61: u64 = (a6 as u64) * (b1 as u64);
    let p62: u64 = (a6 as u64) * (b2 as u64);
    let p63: u64 = (a6 as u64) * (b3 as u64);
    let p64: u64 = (a6 as u64) * (b4 as u64);
    let p65: u64 = (a6 as u64) * (b5 as u64);
    let p66: u64 = (a6 as u64) * (b6 as u64);
    let p67: u64 = (a6 as u64) * (b7 as u64);

    let p70: u64 = (a7 as u64) * (b0 as u64);
    let p71: u64 = (a7 as u64) * (b1 as u64);
    let p72: u64 = (a7 as u64) * (b2 as u64);
    let p73: u64 = (a7 as u64) * (b3 as u64);
    let p74: u64 = (a7 as u64) * (b4 as u64);
    let p75: u64 = (a7 as u64) * (b5 as u64);
    let p76: u64 = (a7 as u64) * (b6 as u64);
    let p77: u64 = (a7 as u64) * (b7 as u64);

    // For each partial product p_ij, lo = (p as u32) zero-extended into a u64
    // for accumulation; hi = p >> 32 (already u64).
    // Inline the cast at use sites for compactness.

    // Limb 0: lo(p00). No prior carry, no hi contributions.
    let acc0: u64 = (p00 % 4294967296u64);
    let m0_u64: u64 = acc0 % 4294967296u64;
    let m0: u32 = m0_u64 as u32;
    let k1: u64 = acc0 / 4294967296u64;

    // Limb 1: prior carry + lo(p01) + lo(p10) + hi(p00)
    let acc1: u64 = k1
        + (p01 % 4294967296u64) + (p10 % 4294967296u64)
        + (p00 / 4294967296u64);
    let m1_u64: u64 = acc1 % 4294967296u64;
    let m1: u32 = m1_u64 as u32;
    let k2: u64 = acc1 / 4294967296u64;

    // Limb 2: k2 + lo(p02, p11, p20) + hi(p01, p10)
    let acc2: u64 = k2
        + (p02 % 4294967296u64) + (p11 % 4294967296u64) + (p20 % 4294967296u64)
        + (p01 / 4294967296u64) + (p10 / 4294967296u64);
    let m2_u64: u64 = acc2 % 4294967296u64;
    let m2: u32 = m2_u64 as u32;
    let k3: u64 = acc2 / 4294967296u64;

    // Limb 3: k3 + lo(p03, p12, p21, p30) + hi(p02, p11, p20)
    let acc3: u64 = k3
        + (p03 % 4294967296u64) + (p12 % 4294967296u64)
        + (p21 % 4294967296u64) + (p30 % 4294967296u64)
        + (p02 / 4294967296u64) + (p11 / 4294967296u64) + (p20 / 4294967296u64);
    let m3_u64: u64 = acc3 % 4294967296u64;
    let m3: u32 = m3_u64 as u32;
    let k4: u64 = acc3 / 4294967296u64;

    // Limb 4: k4 + lo(p04, p13, p22, p31, p40) + hi(p03, p12, p21, p30)
    let acc4: u64 = k4
        + (p04 % 4294967296u64) + (p13 % 4294967296u64)
        + (p22 % 4294967296u64) + (p31 % 4294967296u64) + (p40 % 4294967296u64)
        + (p03 / 4294967296u64) + (p12 / 4294967296u64) + (p21 / 4294967296u64) + (p30 / 4294967296u64);
    let m4_u64: u64 = acc4 % 4294967296u64;
    let m4: u32 = m4_u64 as u32;
    let k5: u64 = acc4 / 4294967296u64;

    // Limb 5: k5 + lo(p05..p50 along anti-diagonal) + hi(p04..p40)
    let acc5: u64 = k5
        + (p05 % 4294967296u64) + (p14 % 4294967296u64) + (p23 % 4294967296u64)
        + (p32 % 4294967296u64) + (p41 % 4294967296u64) + (p50 % 4294967296u64)
        + (p04 / 4294967296u64) + (p13 / 4294967296u64) + (p22 / 4294967296u64)
        + (p31 / 4294967296u64) + (p40 / 4294967296u64);
    let m5_u64: u64 = acc5 % 4294967296u64;
    let m5: u32 = m5_u64 as u32;
    let k6: u64 = acc5 / 4294967296u64;

    // Limb 6: k6 + lo(p06..p60) + hi(p05..p50)
    let acc6: u64 = k6
        + (p06 % 4294967296u64) + (p15 % 4294967296u64) + (p24 % 4294967296u64)
        + (p33 % 4294967296u64) + (p42 % 4294967296u64) + (p51 % 4294967296u64)
        + (p60 % 4294967296u64)
        + (p05 / 4294967296u64) + (p14 / 4294967296u64) + (p23 / 4294967296u64)
        + (p32 / 4294967296u64) + (p41 / 4294967296u64) + (p50 / 4294967296u64);
    let m6_u64: u64 = acc6 % 4294967296u64;
    let m6: u32 = m6_u64 as u32;
    let k7: u64 = acc6 / 4294967296u64;

    // Limb 7: k7 + lo(p07..p70) + hi(p06..p60)
    let acc7: u64 = k7
        + (p07 % 4294967296u64) + (p16 % 4294967296u64) + (p25 % 4294967296u64)
        + (p34 % 4294967296u64) + (p43 % 4294967296u64) + (p52 % 4294967296u64)
        + (p61 % 4294967296u64) + (p70 % 4294967296u64)
        + (p06 / 4294967296u64) + (p15 / 4294967296u64) + (p24 / 4294967296u64)
        + (p33 / 4294967296u64) + (p42 / 4294967296u64) + (p51 / 4294967296u64) + (p60 / 4294967296u64);
    let m7_u64: u64 = acc7 % 4294967296u64;
    let m7: u32 = m7_u64 as u32;
    let k8: u64 = acc7 / 4294967296u64;

    // Limb 8: k8 + lo(p17..p71) + hi(p07..p70)
    let acc8: u64 = k8
        + (p17 % 4294967296u64) + (p26 % 4294967296u64) + (p35 % 4294967296u64)
        + (p44 % 4294967296u64) + (p53 % 4294967296u64) + (p62 % 4294967296u64)
        + (p71 % 4294967296u64)
        + (p07 / 4294967296u64) + (p16 / 4294967296u64) + (p25 / 4294967296u64)
        + (p34 / 4294967296u64) + (p43 / 4294967296u64) + (p52 / 4294967296u64)
        + (p61 / 4294967296u64) + (p70 / 4294967296u64);
    let m8_u64: u64 = acc8 % 4294967296u64;
    let m8: u32 = m8_u64 as u32;
    let k9: u64 = acc8 / 4294967296u64;

    // Limb 9: k9 + lo(p27..p72) + hi(p17..p71)
    let acc9: u64 = k9
        + (p27 % 4294967296u64) + (p36 % 4294967296u64) + (p45 % 4294967296u64)
        + (p54 % 4294967296u64) + (p63 % 4294967296u64) + (p72 % 4294967296u64)
        + (p17 / 4294967296u64) + (p26 / 4294967296u64) + (p35 / 4294967296u64)
        + (p44 / 4294967296u64) + (p53 / 4294967296u64) + (p62 / 4294967296u64) + (p71 / 4294967296u64);
    let m9_u64: u64 = acc9 % 4294967296u64;
    let m9: u32 = m9_u64 as u32;
    let k10: u64 = acc9 / 4294967296u64;

    // Limb 10: k10 + lo(p37..p73) + hi(p27..p72)
    let acc10: u64 = k10
        + (p37 % 4294967296u64) + (p46 % 4294967296u64) + (p55 % 4294967296u64)
        + (p64 % 4294967296u64) + (p73 % 4294967296u64)
        + (p27 / 4294967296u64) + (p36 / 4294967296u64) + (p45 / 4294967296u64)
        + (p54 / 4294967296u64) + (p63 / 4294967296u64) + (p72 / 4294967296u64);
    let m10_u64: u64 = acc10 % 4294967296u64;
    let m10: u32 = m10_u64 as u32;
    let k11: u64 = acc10 / 4294967296u64;

    // Limb 11: k11 + lo(p47..p74) + hi(p37..p73)
    let acc11: u64 = k11
        + (p47 % 4294967296u64) + (p56 % 4294967296u64)
        + (p65 % 4294967296u64) + (p74 % 4294967296u64)
        + (p37 / 4294967296u64) + (p46 / 4294967296u64) + (p55 / 4294967296u64)
        + (p64 / 4294967296u64) + (p73 / 4294967296u64);
    let m11_u64: u64 = acc11 % 4294967296u64;
    let m11: u32 = m11_u64 as u32;
    let k12: u64 = acc11 / 4294967296u64;

    // Limb 12: k12 + lo(p57..p75) + hi(p47..p74)
    let acc12: u64 = k12
        + (p57 % 4294967296u64) + (p66 % 4294967296u64) + (p75 % 4294967296u64)
        + (p47 / 4294967296u64) + (p56 / 4294967296u64) + (p65 / 4294967296u64) + (p74 / 4294967296u64);
    let m12_u64: u64 = acc12 % 4294967296u64;
    let m12: u32 = m12_u64 as u32;
    let k13: u64 = acc12 / 4294967296u64;

    // Limb 13: k13 + lo(p67, p76) + hi(p57, p66, p75)
    let acc13: u64 = k13
        + (p67 % 4294967296u64) + (p76 % 4294967296u64)
        + (p57 / 4294967296u64) + (p66 / 4294967296u64) + (p75 / 4294967296u64);
    let m13_u64: u64 = acc13 % 4294967296u64;
    let m13: u32 = m13_u64 as u32;
    let k14: u64 = acc13 / 4294967296u64;

    // Limb 14: k14 + lo(p77) + hi(p67, p76)
    let acc14: u64 = k14
        + (p77 % 4294967296u64)
        + (p67 / 4294967296u64) + (p76 / 4294967296u64);
    let m14_u64: u64 = acc14 % 4294967296u64;
    let m14: u32 = m14_u64 as u32;
    let k15: u64 = acc14 / 4294967296u64;

    // Limb 15: k15 + hi(p77). No further contributions; this is the top limb.
    let acc15: u64 = k15 + (p77 / 4294967296u64);
    let m15_u64: u64 = acc15 % 4294967296u64;
    let m15: u32 = m15_u64 as u32;

    (m0,  m1,  m2,  m3,  m4,  m5,  m6,  m7,
     m8,  m9,  m10, m11, m12, m13, m14, m15)
}

// felt252_montgomery_reduce: CIOS Montgomery reduction over the Stark prime.
//
// Takes a 16-limb (512-bit) integer T (typically the output of
// felt252_mul_raw) and returns T * R^-1 mod P as an 8-limb value, where
// R = 2^256. For Stark prime P, P mod 2^32 = 1 so P^-1 mod 2^32 = 1 and
// N' = -P^-1 mod 2^32 = 2^32 - 1. The m at each step is m_i = -T_i mod 2^32,
// computed via m_prod = T_i * (2^32 - 1) (truncated to low 32 bits).
//
// P limb-by-limb: (1, 0, 0, 0, 0, 0, 17, 2^27). So adding m*P at position i
// touches three limbs explicitly: i (m*1), i+6 (m*17), i+7 (m*2^27).
// Each m*const product is u64, split into low/high 32-bit halves that
// straddle the boundary at the destination limbs.
//
// After 8 iterations, result is held in limbs 8..15 of the working register.
// Standard Montgomery analysis gives result < 2P, so one conditional
// subtract of P brings it canonical. (A tighter bound proof is deferred.)

fn felt252_montgomery_reduce(
    m0:  u32, m1:  u32, m2:  u32, m3:  u32,
    m4:  u32, m5:  u32, m6:  u32, m7:  u32,
    m8:  u32, m9:  u32, m10: u32, m11: u32,
    m12: u32, m13: u32, m14: u32, m15: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32)
{
    // ===== Iteration 0: zero out limb 0, touches limbs 0..8 =====
    let n0: u32 = ((m0 as u64) * 4294967295u64) as u32;
    let n0_17: u64 = (n0 as u64) * 17u64;
    let n0_17_lo_u64: u64 = n0_17 % 4294967296u64;
    let n0_17_lo: u32 = n0_17_lo_u64 as u32;
    let n0_17_hi: u32 = (n0_17 / 4294967296u64) as u32;
    let n0_pow: u64 = (n0 as u64) * 134217728u64;
    let n0_pow_lo_u64: u64 = n0_pow % 4294967296u64;
    let n0_pow_lo: u32 = n0_pow_lo_u64 as u32;
    let n0_pow_hi: u32 = (n0_pow / 4294967296u64) as u32;

    let a00: u64 = (m0 as u64) + (n0 as u64);
    let k01: u64 = a00 / 4294967296u64;
    let a01: u64 = (m1 as u64) + k01;
    let t0_1_u64: u64 = a01 % 4294967296u64;
    let t0_1: u32 = t0_1_u64 as u32;
    let k02: u64 = a01 / 4294967296u64;
    let a02: u64 = (m2 as u64) + k02;
    let t0_2_u64: u64 = a02 % 4294967296u64;
    let t0_2: u32 = t0_2_u64 as u32;
    let k03: u64 = a02 / 4294967296u64;
    let a03: u64 = (m3 as u64) + k03;
    let t0_3_u64: u64 = a03 % 4294967296u64;
    let t0_3: u32 = t0_3_u64 as u32;
    let k04: u64 = a03 / 4294967296u64;
    let a04: u64 = (m4 as u64) + k04;
    let t0_4_u64: u64 = a04 % 4294967296u64;
    let t0_4: u32 = t0_4_u64 as u32;
    let k05: u64 = a04 / 4294967296u64;
    let a05: u64 = (m5 as u64) + k05;
    let t0_5_u64: u64 = a05 % 4294967296u64;
    let t0_5: u32 = t0_5_u64 as u32;
    let k06: u64 = a05 / 4294967296u64;
    let a06: u64 = (m6 as u64) + (n0_17_lo as u64) + k06;
    let t0_6_u64: u64 = a06 % 4294967296u64;
    let t0_6: u32 = t0_6_u64 as u32;
    let k07: u64 = a06 / 4294967296u64;
