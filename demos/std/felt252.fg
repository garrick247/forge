// Montgomery iteration 7: zeroes out limb 7.
fn mont_iter_7(
    t0:  u32, t1:  u32, t2:  u32, t3:  u32,
    t4:  u32, t5:  u32, t6:  u32, t7:  u32,
    t8:  u32, t9:  u32, t10: u32, t11: u32,
    t12: u32, t13: u32, t14: u32, t15: u32,
    cap_in: u64
) -> (u32, u32, u32, u32, u32, u32, u32, u32,
      u32, u32, u32, u32, u32, u32, u32, u32, u64)
    requires cap_in <= 1u64
    ensures result.7 == 0u32
    ensures result.16 <= 1u64
{
    // m = t7 * N' mod 2^32, where N' = 2^32 - 1.
    let m_prod: u64 = (t7 as u64) * 4294967295u64;
    let m_u64: u64 = m_prod % 4294967296u64;
    let m: u32 = m_u64 as u32;
    let m17: u64 = (m as u64) * 17u64;
    let m17_lo: u32 = (m17 % 4294967296u64) as u32;
    let m17_hi: u32 = (m17 / 4294967296u64) as u32;
    let mpow: u64 = (m as u64) * 134217728u64;
    let mpow_lo: u32 = (mpow % 4294967296u64) as u32;
    let mpow_hi: u32 = (mpow / 4294967296u64) as u32;

    let new_t0: u32 = t0;
    let new_t1: u32 = t1;
    let new_t2: u32 = t2;
    let new_t3: u32 = t3;
    let new_t4: u32 = t4;
    let new_t5: u32 = t5;
    let new_t6: u32 = t6;
    let acc7: u64 = (t7 as u64) + (m as u64);
    let new_t7_u64: u64 = acc7 % 4294967296u64;
    let new_t7: u32 = new_t7_u64 as u32;
    let k8: u64 = acc7 / 4294967296u64;
    let acc8: u64 = (t8 as u64) + k8;
    let new_t8_u64: u64 = acc8 % 4294967296u64;
    let new_t8: u32 = new_t8_u64 as u32;
    let k9: u64 = acc8 / 4294967296u64;
    let acc9: u64 = (t9 as u64) + k9;
    let new_t9_u64: u64 = acc9 % 4294967296u64;
    let new_t9: u32 = new_t9_u64 as u32;
    let k10: u64 = acc9 / 4294967296u64;
    let acc10: u64 = (t10 as u64) + k10;
    let new_t10_u64: u64 = acc10 % 4294967296u64;
    let new_t10: u32 = new_t10_u64 as u32;
    let k11: u64 = acc10 / 4294967296u64;
    let acc11: u64 = (t11 as u64) + k11;
    let new_t11_u64: u64 = acc11 % 4294967296u64;
    let new_t11: u32 = new_t11_u64 as u32;
    let k12: u64 = acc11 / 4294967296u64;
    let acc12: u64 = (t12 as u64) + k12;
    let new_t12_u64: u64 = acc12 % 4294967296u64;
    let new_t12: u32 = new_t12_u64 as u32;
    let k13: u64 = acc12 / 4294967296u64;
    let acc13: u64 = (t13 as u64) + (m17_lo as u64) + k13;
    let new_t13_u64: u64 = acc13 % 4294967296u64;
    let new_t13: u32 = new_t13_u64 as u32;
    let k14: u64 = acc13 / 4294967296u64;
    let acc14: u64 = (t14 as u64) + (m17_hi as u64) + (mpow_lo as u64) + k14;
    let new_t14_u64: u64 = acc14 % 4294967296u64;
    let new_t14: u32 = new_t14_u64 as u32;
    let k15: u64 = acc14 / 4294967296u64;
    let acc15: u64 = (t15 as u64) + (mpow_hi as u64) + k15 + cap_in;
    let new_t15_u64: u64 = acc15 % 4294967296u64;
    let new_t15: u32 = new_t15_u64 as u32;
    let cap_out: u64 = acc15 / 4294967296u64;
    (new_t0,  new_t1,  new_t2,  new_t3,
     new_t4,  new_t5,  new_t6,  new_t7,
     new_t8,  new_t9,  new_t10, new_t11,
     new_t12, new_t13, new_t14, new_t15, cap_out)
}


// ---- felt252_montgomery_reduce_v2: composed from the 8 verified iterations
//
// Math-correctness inherited per-iteration:
//   - mont_iter_K guarantees result.K == 0u32 after iteration K (verified).
// Together, the 8 chained calls produce a 16-limb state with limbs 0..7 all
// zero -- the running state has been right-shifted by 256 bits (R^-1
// multiplication) modulo P, modulo a final conditional subtract.
//
// Output: the high 8 limbs of the final state, conditionally reduced
// against P using the same sub_with_borrow_diff / sub_with_borrow_out
// helpers used by the original felt252_montgomery_reduce.

fn felt252_montgomery_reduce_v2(
    m0:  u32, m1:  u32, m2:  u32, m3:  u32,
    m4:  u32, m5:  u32, m6:  u32, m7:  u32,
    m8:  u32, m9:  u32, m10: u32, m11: u32,
    m12: u32, m13: u32, m14: u32, m15: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32)
{
    let (s0_0,  s0_1,  s0_2,  s0_3,  s0_4,  s0_5,  s0_6,  s0_7,
         s0_8,  s0_9,  s0_10, s0_11, s0_12, s0_13, s0_14, s0_15, cap0) =
        mont_iter_0(m0,  m1,  m2,  m3,  m4,  m5,  m6,  m7,
                    m8,  m9,  m10, m11, m12, m13, m14, m15, 0u64);
    let (s1_0,  s1_1,  s1_2,  s1_3,  s1_4,  s1_5,  s1_6,  s1_7,
         s1_8,  s1_9,  s1_10, s1_11, s1_12, s1_13, s1_14, s1_15, cap1) =
        mont_iter_1(s0_0,  s0_1,  s0_2,  s0_3,  s0_4,  s0_5,  s0_6,  s0_7,
                    s0_8,  s0_9,  s0_10, s0_11, s0_12, s0_13, s0_14, s0_15, cap0);
    let (s2_0,  s2_1,  s2_2,  s2_3,  s2_4,  s2_5,  s2_6,  s2_7,
         s2_8,  s2_9,  s2_10, s2_11, s2_12, s2_13, s2_14, s2_15, cap2) =
        mont_iter_2(s1_0,  s1_1,  s1_2,  s1_3,  s1_4,  s1_5,  s1_6,  s1_7,
                    s1_8,  s1_9,  s1_10, s1_11, s1_12, s1_13, s1_14, s1_15, cap1);
    let (s3_0,  s3_1,  s3_2,  s3_3,  s3_4,  s3_5,  s3_6,  s3_7,
         s3_8,  s3_9,  s3_10, s3_11, s3_12, s3_13, s3_14, s3_15, cap3) =
        mont_iter_3(s2_0,  s2_1,  s2_2,  s2_3,  s2_4,  s2_5,  s2_6,  s2_7,
                    s2_8,  s2_9,  s2_10, s2_11, s2_12, s2_13, s2_14, s2_15, cap2);
    let (s4_0,  s4_1,  s4_2,  s4_3,  s4_4,  s4_5,  s4_6,  s4_7,
         s4_8,  s4_9,  s4_10, s4_11, s4_12, s4_13, s4_14, s4_15, cap4) =
        mont_iter_4(s3_0,  s3_1,  s3_2,  s3_3,  s3_4,  s3_5,  s3_6,  s3_7,
                    s3_8,  s3_9,  s3_10, s3_11, s3_12, s3_13, s3_14, s3_15, cap3);
    let (s5_0,  s5_1,  s5_2,  s5_3,  s5_4,  s5_5,  s5_6,  s5_7,
         s5_8,  s5_9,  s5_10, s5_11, s5_12, s5_13, s5_14, s5_15, cap5) =
        mont_iter_5(s4_0,  s4_1,  s4_2,  s4_3,  s4_4,  s4_5,  s4_6,  s4_7,
                    s4_8,  s4_9,  s4_10, s4_11, s4_12, s4_13, s4_14, s4_15, cap4);
    let (s6_0,  s6_1,  s6_2,  s6_3,  s6_4,  s6_5,  s6_6,  s6_7,
         s6_8,  s6_9,  s6_10, s6_11, s6_12, s6_13, s6_14, s6_15, cap6) =
        mont_iter_6(s5_0,  s5_1,  s5_2,  s5_3,  s5_4,  s5_5,  s5_6,  s5_7,
                    s5_8,  s5_9,  s5_10, s5_11, s5_12, s5_13, s5_14, s5_15, cap5);
    let (_s7_0, _s7_1, _s7_2, _s7_3, _s7_4, _s7_5, _s7_6, _s7_7,
         s7_8,  s7_9,  s7_10, s7_11, s7_12, s7_13, s7_14, s7_15, cap7) =
        mont_iter_7(s6_0,  s6_1,  s6_2,  s6_3,  s6_4,  s6_5,  s6_6,  s6_7,
                    s6_8,  s6_9,  s6_10, s6_11, s6_12, s6_13, s6_14, s6_15, cap6);

    // Conditional subtract of P, mirroring felt252_montgomery_reduce.
    let r0d: u32 = sub_with_borrow_diff(s7_8,  STARK_P_LIMB0, 0u32);
    let rb0: u32 = sub_with_borrow_out (s7_8,  STARK_P_LIMB0, 0u32);
    let r1d: u32 = sub_with_borrow_diff(s7_9,  STARK_P_LIMB1, rb0);
    let rb1: u32 = sub_with_borrow_out (s7_9,  STARK_P_LIMB1, rb0);
    let r2d: u32 = sub_with_borrow_diff(s7_10, STARK_P_LIMB2, rb1);
    let rb2: u32 = sub_with_borrow_out (s7_10, STARK_P_LIMB2, rb1);
    let r3d: u32 = sub_with_borrow_diff(s7_11, STARK_P_LIMB3, rb2);
    let rb3: u32 = sub_with_borrow_out (s7_11, STARK_P_LIMB3, rb2);
    let r4d: u32 = sub_with_borrow_diff(s7_12, STARK_P_LIMB4, rb3);
    let rb4: u32 = sub_with_borrow_out (s7_12, STARK_P_LIMB4, rb3);
    let r5d: u32 = sub_with_borrow_diff(s7_13, STARK_P_LIMB5, rb4);
    let rb5: u32 = sub_with_borrow_out (s7_13, STARK_P_LIMB5, rb4);
    let r6d: u32 = sub_with_borrow_diff(s7_14, STARK_P_LIMB6, rb5);
    let rb6: u32 = sub_with_borrow_out (s7_14, STARK_P_LIMB6, rb5);
    let r7d: u32 = sub_with_borrow_diff(s7_15, STARK_P_LIMB7, rb6);
    let rb7: u32 = sub_with_borrow_out (s7_15, STARK_P_LIMB7, rb6);

    let use_diff: u32 = if cap7 >= 1u64 {
        1u32
    } else {
        if rb7 == 0u32 { 1u32 } else { 0u32 }
    };

    let r0: u32 = if use_diff == 1u32 { r0d } else { s7_8  };
    let r1: u32 = if use_diff == 1u32 { r1d } else { s7_9  };
    let r2: u32 = if use_diff == 1u32 { r2d } else { s7_10 };
    let r3: u32 = if use_diff == 1u32 { r3d } else { s7_11 };
    let r4: u32 = if use_diff == 1u32 { r4d } else { s7_12 };
    let r5: u32 = if use_diff == 1u32 { r5d } else { s7_13 };
    let r6: u32 = if use_diff == 1u32 { r6d } else { s7_14 };
    let r7: u32 = if use_diff == 1u32 { r7d } else { s7_15 };

    (r0, r1, r2, r3, r4, r5, r6, r7)
}

// ---- felt252_montgomery_reduce_spec: wrapper over the verified base ------
//
// Contract-correctness is verified on felt252_montgomery_reduce (above):
// every helper precondition is discharged transitively. Math-correctness
// at the per-iteration level (eight CIOS iterations each updating 9 of
// 16 limbs based on an m derived from the running state) is the next
// research piece -- the projection expression for any single output limb
// after 8 iterations is ~8x deeper than mul_raw_spec's, putting the
// query past Z3's automatic-discharge envelope even with the
// per-function decomposition. Standard literature (Vale-Crypto,
// Fiat-Cryptography) addresses this with hand-written carry-tracking
// lemmas; that is the natural next swing here.

fn felt252_montgomery_reduce_spec(
    m0:  u32, m1:  u32, m2:  u32, m3:  u32,
    m4:  u32, m5:  u32, m6:  u32, m7:  u32,
    m8:  u32, m9:  u32, m10: u32, m11: u32,
    m12: u32, m13: u32, m14: u32, m15: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32)
{
    felt252_montgomery_reduce_v2(
        m0,  m1,  m2,  m3,  m4,  m5,  m6,  m7,
        m8,  m9,  m10, m11, m12, m13, m14, m15)
}

// ---- felt252_mul_spec: composition of mul_raw_spec + montgomery_reduce ---
//
// Math-correctness inheritance:
//   - felt252_mul_raw_spec produces a 16-limb integer product that is
//     verified per limb against the schoolbook projection (16 separate
//     verified per-limb functions, commit 3400433).
//   - felt252_montgomery_reduce_spec performs the CIOS Montgomery reduce
//     on that 16-limb input. Its per-iteration math-correctness is the
//     deferred research piece noted above; contract-correctness is
//     transitively verified via the helpers it delegates to.
//
// The composition's result is therefore (a * b) * R^-1 mod P in
// Montgomery form, matching the semantics of felt252_mul (which uses
// the original `_raw` and `_montgomery_reduce` functions).

fn felt252_mul_spec(
    a0: u32, a1: u32, a2: u32, a3: u32,
    a4: u32, a5: u32, a6: u32, a7: u32,
    b0: u32, b1: u32, b2: u32, b3: u32,
    b4: u32, b5: u32, b6: u32, b7: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32)
{
    let (p0,  p1,  p2,  p3,  p4,  p5,  p6,  p7,
         p8,  p9,  p10, p11, p12, p13, p14, p15) =
        felt252_mul_raw_spec(
            a0, a1, a2, a3, a4, a5, a6, a7,
            b0, b1, b2, b3, b4, b5, b6, b7);
    felt252_montgomery_reduce_spec(
        p0,  p1,  p2,  p3,  p4,  p5,  p6,  p7,
        p8,  p9,  p10, p11, p12, p13, p14, p15)
}

// ---- ec_double: Stark-curve point doubling -------------------------------
// Inputs (x, y) and output (x_new, y_new) are all in Montgomery form.
// alpha = 1 (canonical) is converted to Montgomery form via felt252_to_mont
// inside the body; for a hot loop you'd hoist that to a precomputed constant.

fn ec_double(
    x0: u32, x1: u32, x2: u32, x3: u32, x4: u32, x5: u32, x6: u32, x7: u32,
    y0: u32, y1: u32, y2: u32, y3: u32, y4: u32, y5: u32, y6: u32, y7: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32,
      u32, u32, u32, u32, u32, u32, u32, u32)
{
    // alpha = 1 in Montgomery form (= R mod P)
    let (am_0, am_1, am_2, am_3, am_4, am_5, am_6, am_7) = felt252_to_mont(
            1u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32);

    // x^2
    let (xsq_0, xsq_1, xsq_2, xsq_3, xsq_4, xsq_5, xsq_6, xsq_7) = felt252_sqr(
            x0, x1, x2, x3, x4, x5, x6, x7);

    // 3 * x^2  = x^2 + x^2 + x^2
    let (twoxsq_0, twoxsq_1, twoxsq_2, twoxsq_3, twoxsq_4, twoxsq_5, twoxsq_6, twoxsq_7) = felt252_add(
            xsq_0, xsq_1, xsq_2, xsq_3, xsq_4, xsq_5, xsq_6, xsq_7,
            xsq_0, xsq_1, xsq_2, xsq_3, xsq_4, xsq_5, xsq_6, xsq_7);
    let (threexsq_0, threexsq_1, threexsq_2, threexsq_3, threexsq_4, threexsq_5, threexsq_6, threexsq_7) = felt252_add(
            twoxsq_0, twoxsq_1, twoxsq_2, twoxsq_3, twoxsq_4, twoxsq_5, twoxsq_6, twoxsq_7,
            xsq_0, xsq_1, xsq_2, xsq_3, xsq_4, xsq_5, xsq_6, xsq_7);

    // numerator = 3*x^2 + alpha
    let (num_0, num_1, num_2, num_3, num_4, num_5, num_6, num_7) = felt252_add(
            threexsq_0, threexsq_1, threexsq_2, threexsq_3, threexsq_4, threexsq_5, threexsq_6, threexsq_7,
            am_0, am_1, am_2, am_3, am_4, am_5, am_6, am_7);

    // 2y
    let (twoy_0, twoy_1, twoy_2, twoy_3, twoy_4, twoy_5, twoy_6, twoy_7) = felt252_add(
            y0, y1, y2, y3, y4, y5, y6, y7,
            y0, y1, y2, y3, y4, y5, y6, y7);

    // (2y)^-1
    let (inv2y_0, inv2y_1, inv2y_2, inv2y_3, inv2y_4, inv2y_5, inv2y_6, inv2y_7) = felt252_inv(
            twoy_0, twoy_1, twoy_2, twoy_3, twoy_4, twoy_5, twoy_6, twoy_7);

    // lambda = numerator * (2y)^-1
    let (lam_0, lam_1, lam_2, lam_3, lam_4, lam_5, lam_6, lam_7) = felt252_mul(
            num_0, num_1, num_2, num_3, num_4, num_5, num_6, num_7,
            inv2y_0, inv2y_1, inv2y_2, inv2y_3, inv2y_4, inv2y_5, inv2y_6, inv2y_7);

    // lambda^2
    let (lamsq_0, lamsq_1, lamsq_2, lamsq_3, lamsq_4, lamsq_5, lamsq_6, lamsq_7) = felt252_sqr(
            lam_0, lam_1, lam_2, lam_3, lam_4, lam_5, lam_6, lam_7);

    // 2x
    let (twox_0, twox_1, twox_2, twox_3, twox_4, twox_5, twox_6, twox_7) = felt252_add(
            x0, x1, x2, x3, x4, x5, x6, x7,
            x0, x1, x2, x3, x4, x5, x6, x7);

    // x_new = lambda^2 - 2x
    let (xnew_0, xnew_1, xnew_2, xnew_3, xnew_4, xnew_5, xnew_6, xnew_7) = felt252_sub(
            lamsq_0, lamsq_1, lamsq_2, lamsq_3, lamsq_4, lamsq_5, lamsq_6, lamsq_7,
            twox_0, twox_1, twox_2, twox_3, twox_4, twox_5, twox_6, twox_7);

    // x - x_new
    let (xmxn_0, xmxn_1, xmxn_2, xmxn_3, xmxn_4, xmxn_5, xmxn_6, xmxn_7) = felt252_sub(
            x0, x1, x2, x3, x4, x5, x6, x7,
            xnew_0, xnew_1, xnew_2, xnew_3, xnew_4, xnew_5, xnew_6, xnew_7);

    // lambda * (x - x_new)
    let (lxmxn_0, lxmxn_1, lxmxn_2, lxmxn_3, lxmxn_4, lxmxn_5, lxmxn_6, lxmxn_7) = felt252_mul(
            lam_0, lam_1, lam_2, lam_3, lam_4, lam_5, lam_6, lam_7,
            xmxn_0, xmxn_1, xmxn_2, xmxn_3, xmxn_4, xmxn_5, xmxn_6, xmxn_7);

    // y_new = lambda * (x - x_new) - y
    let (ynew_0, ynew_1, ynew_2, ynew_3, ynew_4, ynew_5, ynew_6, ynew_7) = felt252_sub(
            lxmxn_0, lxmxn_1, lxmxn_2, lxmxn_3, lxmxn_4, lxmxn_5, lxmxn_6, lxmxn_7,
            y0, y1, y2, y3, y4, y5, y6, y7);

    (xnew_0, xnew_1, xnew_2, xnew_3, xnew_4, xnew_5, xnew_6, xnew_7,
     ynew_0, ynew_1, ynew_2, ynew_3, ynew_4, ynew_5, ynew_6, ynew_7)
}

// ---- ec_add: Stark-curve point addition ----------------------------------
// Inputs P1 = (x1, y1) and P2 = (x2, y2) and output P3 = (x3, y3) all in
// Montgomery form. Assumes x1 != x2 (i.e. P1 != +/- P2); the doubling and
// identity cases are caller responsibilities.

fn ec_add(
    x10: u32, x11: u32, x12: u32, x13: u32,
    x14: u32, x15: u32, x16: u32, x17: u32,
    y10: u32, y11: u32, y12: u32, y13: u32,
    y14: u32, y15: u32, y16: u32, y17: u32,
    x20: u32, x21: u32, x22: u32, x23: u32,
    x24: u32, x25: u32, x26: u32, x27: u32,
    y20: u32, y21: u32, y22: u32, y23: u32,
    y24: u32, y25: u32, y26: u32, y27: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32,
      u32, u32, u32, u32, u32, u32, u32, u32)
{
    // dy = y2 - y1
    let (dy_0, dy_1, dy_2, dy_3, dy_4, dy_5, dy_6, dy_7) = felt252_sub(
            y20, y21, y22, y23, y24, y25, y26, y27,
            y10, y11, y12, y13, y14, y15, y16, y17);

    // dx = x2 - x1
    let (dx_0, dx_1, dx_2, dx_3, dx_4, dx_5, dx_6, dx_7) = felt252_sub(
            x20, x21, x22, x23, x24, x25, x26, x27,
            x10, x11, x12, x13, x14, x15, x16, x17);

    // (x2 - x1)^-1
    let (invdx_0, invdx_1, invdx_2, invdx_3, invdx_4, invdx_5, invdx_6, invdx_7) = felt252_inv(
            dx_0, dx_1, dx_2, dx_3, dx_4, dx_5, dx_6, dx_7);

    // lambda = (y2 - y1) * (x2 - x1)^-1
    let (lam_0, lam_1, lam_2, lam_3, lam_4, lam_5, lam_6, lam_7) = felt252_mul(
            dy_0, dy_1, dy_2, dy_3, dy_4, dy_5, dy_6, dy_7,
            invdx_0, invdx_1, invdx_2, invdx_3, invdx_4, invdx_5, invdx_6, invdx_7);

    // lambda^2
    let (lamsq_0, lamsq_1, lamsq_2, lamsq_3, lamsq_4, lamsq_5, lamsq_6, lamsq_7) = felt252_sqr(
            lam_0, lam_1, lam_2, lam_3, lam_4, lam_5, lam_6, lam_7);

    // x1 + x2
    let (xsum_0, xsum_1, xsum_2, xsum_3, xsum_4, xsum_5, xsum_6, xsum_7) = felt252_add(
            x10, x11, x12, x13, x14, x15, x16, x17,
            x20, x21, x22, x23, x24, x25, x26, x27);

    // x3 = lambda^2 - (x1 + x2)
    let (x3_0, x3_1, x3_2, x3_3, x3_4, x3_5, x3_6, x3_7) = felt252_sub(
            lamsq_0, lamsq_1, lamsq_2, lamsq_3, lamsq_4, lamsq_5, lamsq_6, lamsq_7,
            xsum_0, xsum_1, xsum_2, xsum_3, xsum_4, xsum_5, xsum_6, xsum_7);

    // x1 - x3
    let (xmx3_0, xmx3_1, xmx3_2, xmx3_3, xmx3_4, xmx3_5, xmx3_6, xmx3_7) = felt252_sub(
            x10, x11, x12, x13, x14, x15, x16, x17,
            x3_0, x3_1, x3_2, x3_3, x3_4, x3_5, x3_6, x3_7);

    // lambda * (x1 - x3)
    let (lxmx3_0, lxmx3_1, lxmx3_2, lxmx3_3, lxmx3_4, lxmx3_5, lxmx3_6, lxmx3_7) = felt252_mul(
            lam_0, lam_1, lam_2, lam_3, lam_4, lam_5, lam_6, lam_7,
            xmx3_0, xmx3_1, xmx3_2, xmx3_3, xmx3_4, xmx3_5, xmx3_6, xmx3_7);

    // y3 = lambda * (x1 - x3) - y1
    let (y3_0, y3_1, y3_2, y3_3, y3_4, y3_5, y3_6, y3_7) = felt252_sub(
            lxmx3_0, lxmx3_1, lxmx3_2, lxmx3_3, lxmx3_4, lxmx3_5, lxmx3_6, lxmx3_7,
            y10, y11, y12, y13, y14, y15, y16, y17);

    (x3_0, x3_1, x3_2, x3_3, x3_4, x3_5, x3_6, x3_7,
     y3_0, y3_1, y3_2, y3_3, y3_4, y3_5, y3_6, y3_7)
}


// ---- Candidate spec language for full mathematical correctness ----------
// The current ensures clauses on the felt252_* family verify CONTRACT
// correctness only: every helper's requires is discharged by the
// preceding helper's ensures. They do NOT verify the mathematical
// contract (result equals (a + b) mod P, etc.).
//
// Forge's spec language IS expressive enough to STATE the mathematical
// contract. Forge has u256/u512/u1024/bv256 native types; ensures
// clauses support `+`, `*`, implicit promotion, helper-function calls,
// and `result.N` tuple field access. The helpers above (recon_u256_8,
// stark_p_u256) are the reconstruction primitives.
//
// What Z3 CANNOT do automatically (verified empirically on 2026-05-23
// over both the full spec `recon(result) == (recon(a)+recon(b)) % P`
// and the weaker canonicity bound `recon(result) < P`):
// discharge the obligation that connects 8 limb-wise u32 operations
// to the abstract u256 modular equivalence. Standard carry-tracking
// lemmas (see Fiat-Cryptography or Vale-Crypto) bridge that gap.
// Adding those is the next layer; Forge supports `guided` and `manual`
// proof categories per the proof summary header for exactly this case.

// ---- felt252_add: 8-limb modular add over the Stark prime -----------------


// ---- felt252_add_bigint_spec: 8-limb carry chain ↔ 257-bit integer sum ---
//
// Math-correctness via Int-mode Z3 encoding: the 9-tuple (s0..s7, c7) is
// the bit-level representation of (a + b) as a 257-bit unsigned integer,
// where a and b are 256-bit unsigned integers reconstructed from their 8
// u32 limbs (LSB-first). This is the foundation of `felt252_add_mod_bigint_spec`
// which lifts the same claim to (a + b) mod P.
//
// The proof relies on the equational ensures on add_with_carry_sum and
// add_with_carry_out (lifted as part of this layer). Z3 in Int mode treats
// u32/u64 as Int with range constraints; the modular arithmetic in the
// helpers' postconditions provides the per-limb spec that the bigint claim
// composes.

fn felt252_add_bigint_spec(
    a0: u32, a1: u32, a2: u32, a3: u32,
    a4: u32, a5: u32, a6: u32, a7: u32,
    b0: u32, b1: u32, b2: u32, b3: u32,
    b4: u32, b5: u32, b6: u32, b7: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32, u32)
