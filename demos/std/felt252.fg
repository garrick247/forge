    let cap7: u64 = h0f / 4294967296u64;
    let use_diff: u32 = if cap7 >= 1u64 {
        1u32
    } else {
        if rb7 == 0u32 { 1u32 } else { 0u32 }
    };

    let r0: u32 = if use_diff == 1u32 { r0d } else { t7_8  };
