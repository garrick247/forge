               bx0, bx1, bx2, bx3, bx4, bx5, bx6, bx7,
               by0, by1, by2, by3, by4, by5, by6, by7);

    // Tuple-typed if: Z3 case-splits on bit and uses the appropriate
    // branch's ensures. ec_double ensures curve(dx, dy); ec_add ensures
    // curve(ax, ay). Result curve(.) follows by case analysis.
    if bit == 1u32 {
        (ax0, ax1, ax2, ax3, ax4, ax5, ax6, ax7, ay0, ay1, ay2, ay3, ay4, ay5, ay6, ay7)
    } else {
        (dx0, dx1, dx2, dx3, dx4, dx5, dx6, dx7, dy0, dy1, dy2, dy3, dy4, dy5, dy6, dy7)
    }
}


// ---- pedersen_scalar_mul_32: 32-round unrolled double-and-add demo ----
// 32 rounds of pedersen_step over the low 32 bits of a scalar. Phase 2
// of the Pedersen build. The full Stark Pedersen needs 248 rounds per
// scalar chunk; that hit a Z3 timeout at 3000s because each pedersen_step
// call site requires verifying curve(running) — over 248 chained calls
// the propagation overwhelms auto-discharge. The 32-round demo
