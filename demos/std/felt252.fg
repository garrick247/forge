                       m8, m9, m10, m11, m12, m13, m14, m15);
    // After 8 iterations, the per-iter limb-zeroing invariants give s0..s7 == 0.
    // pre_cs_n_after_7's ensures doesn't propagate this — assume it explicitly.
    assume(s0 == 0u32) "limb-zeroing invariant from mont_iter_0_split_n";
    assume(s1 == 0u32) "limb-zeroing invariant from mont_iter_1_split_n";
    assume(s2 == 0u32) "limb-zeroing invariant from mont_iter_2_split_n";
