    let m17_hi: u32 = (m17 / 4294967296u64) as u32;
    let mpow: u64 = (m as u64) * 134217728u64;
    let mpow_lo: u32 = (mpow % 4294967296u64) as u32;
    let mpow_hi: u32 = (mpow / 4294967296u64) as u32;

