// ---- Montgomery form conversions -----------------------------------
// Canonical form of v is the natural 8-limb representation of v in [0, P).
// Montgomery form of v is v*R mod P, where R = 2^256. The Montgomery
// multiplication felt252_mul produces a * b * R^-1 mod P, so:
//   to_mont(v)        = felt252_mul(v, R^2 mod P)   (gives v*R)
//   from_mont(v_mont) = felt252_mul(v_mont, 1)      (gives v_mont * R^-1)
//
// R^2 mod P precomputed below, split into 8 u32 limbs LSB-first.

const STARK_R2_LIMB0: u32 = 2113930241u32;   // 0x7E000401
const STARK_R2_LIMB1: u32 = 4294966643u32;   // 0xFFFFFD73
const STARK_R2_LIMB2: u32 = 856686591u32;   // 0x330FFFFF
const STARK_R2_LIMB3: u32 = 1u32;   // 0x00000001
const STARK_R2_LIMB4: u32 = 4285497344u32;   // 0xFF6F8000
const STARK_R2_LIMB5: u32 = 4294967295u32;   // 0xFFFFFFFF
const STARK_R2_LIMB6: u32 = 1577093136u32;   // 0x5E008810
const STARK_R2_LIMB7: u32 = 134206635u32;   // 0x07FFD4AB

fn felt252_to_mont(
    a0: u32, a1: u32, a2: u32, a3: u32,
    a4: u32, a5: u32, a6: u32, a7: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32)
{
    felt252_mul(a0, a1, a2, a3, a4, a5, a6, a7,
                STARK_R2_LIMB0, STARK_R2_LIMB1,
                STARK_R2_LIMB2, STARK_R2_LIMB3,
                STARK_R2_LIMB4, STARK_R2_LIMB5,
                STARK_R2_LIMB6, STARK_R2_LIMB7)
}

fn felt252_from_mont(
    a0: u32, a1: u32, a2: u32, a3: u32,
    a4: u32, a5: u32, a6: u32, a7: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32)
{
    // Multiply by 1 (as 8-limb integer) to apply one Montgomery reduction.
    felt252_mul(a0, a1, a2, a3, a4, a5, a6, a7,
                1u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32)
}


