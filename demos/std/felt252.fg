    let m2_u64: u64 = acc2 % 4294967296u64;
    let m2: u32 = m2_u64 as u32;
    let k3: u64 = acc2 / 4294967296u64;

    // Limb 3: k3 + lo(p03, p12, p21, p30) + hi(p02, p11, p20)
    let acc3: u64 = k3
        + (p03 % 4294967296u64) + (p12 % 4294967296u64)
        + (p21 % 4294967296u64) + (p30 % 4294967296u64)
        + (p02 / 4294967296u64) + (p11 / 4294967296u64) + (p20 / 4294967296u64);
    let m3_u64: u64 = acc3 % 4294967296u64;
    let m3: u32 = m3_u64 as u32;
    let k4: u64 = acc3 / 4294967296u64;

    // Limb 4: k4 + lo(p04, p13, p22, p31, p40) + hi(p03, p12, p21, p30)
    let acc4: u64 = k4
        + (p04 % 4294967296u64) + (p13 % 4294967296u64)
        + (p22 % 4294967296u64) + (p31 % 4294967296u64) + (p40 % 4294967296u64)
        + (p03 / 4294967296u64) + (p12 / 4294967296u64) + (p21 / 4294967296u64) + (p30 / 4294967296u64);
    let m4_u64: u64 = acc4 % 4294967296u64;
    let m4: u32 = m4_u64 as u32;
    let k5: u64 = acc4 / 4294967296u64;

    // Limb 5: k5 + lo(p05..p50 along anti-diagonal) + hi(p04..p40)
    let acc5: u64 = k5
        + (p05 % 4294967296u64) + (p14 % 4294967296u64) + (p23 % 4294967296u64)
        + (p32 % 4294967296u64) + (p41 % 4294967296u64) + (p50 % 4294967296u64)
        + (p04 / 4294967296u64) + (p13 / 4294967296u64) + (p22 / 4294967296u64)
        + (p31 / 4294967296u64) + (p40 / 4294967296u64);
    let m5_u64: u64 = acc5 % 4294967296u64;
    let m5: u32 = m5_u64 as u32;
    let k6: u64 = acc5 / 4294967296u64;

    // Limb 6: k6 + lo(p06..p60) + hi(p05..p50)
    let acc6: u64 = k6
        + (p06 % 4294967296u64) + (p15 % 4294967296u64) + (p24 % 4294967296u64)
        + (p33 % 4294967296u64) + (p42 % 4294967296u64) + (p51 % 4294967296u64)
        + (p60 % 4294967296u64)
        + (p05 / 4294967296u64) + (p14 / 4294967296u64) + (p23 / 4294967296u64)
        + (p32 / 4294967296u64) + (p41 / 4294967296u64) + (p50 / 4294967296u64);
    let m6_u64: u64 = acc6 % 4294967296u64;
    let m6: u32 = m6_u64 as u32;
    let k7: u64 = acc6 / 4294967296u64;

    // Limb 7: k7 + lo(p07..p70) + hi(p06..p60)
    let acc7: u64 = k7
        + (p07 % 4294967296u64) + (p16 % 4294967296u64) + (p25 % 4294967296u64)
        + (p34 % 4294967296u64) + (p43 % 4294967296u64) + (p52 % 4294967296u64)
        + (p61 % 4294967296u64) + (p70 % 4294967296u64)
        + (p06 / 4294967296u64) + (p15 / 4294967296u64) + (p24 / 4294967296u64)
        + (p33 / 4294967296u64) + (p42 / 4294967296u64) + (p51 / 4294967296u64) + (p60 / 4294967296u64);
    let m7_u64: u64 = acc7 % 4294967296u64;
    let m7: u32 = m7_u64 as u32;
    let k8: u64 = acc7 / 4294967296u64;

    // Limb 8: k8 + lo(p17..p71) + hi(p07..p70)
    let acc8: u64 = k8
        + (p17 % 4294967296u64) + (p26 % 4294967296u64) + (p35 % 4294967296u64)
        + (p44 % 4294967296u64) + (p53 % 4294967296u64) + (p62 % 4294967296u64)
        + (p71 % 4294967296u64)
        + (p07 / 4294967296u64) + (p16 / 4294967296u64) + (p25 / 4294967296u64)
        + (p34 / 4294967296u64) + (p43 / 4294967296u64) + (p52 / 4294967296u64)
        + (p61 / 4294967296u64) + (p70 / 4294967296u64);
    let m8_u64: u64 = acc8 % 4294967296u64;
    let m8: u32 = m8_u64 as u32;
    let k9: u64 = acc8 / 4294967296u64;

    // Limb 9: k9 + lo(p27..p72) + hi(p17..p71)
    let acc9: u64 = k9
        + (p27 % 4294967296u64) + (p36 % 4294967296u64) + (p45 % 4294967296u64)
        + (p54 % 4294967296u64) + (p63 % 4294967296u64) + (p72 % 4294967296u64)
        + (p17 / 4294967296u64) + (p26 / 4294967296u64) + (p35 / 4294967296u64)
        + (p44 / 4294967296u64) + (p53 / 4294967296u64) + (p62 / 4294967296u64) + (p71 / 4294967296u64);
    let m9_u64: u64 = acc9 % 4294967296u64;
    let m9: u32 = m9_u64 as u32;
    let k10: u64 = acc9 / 4294967296u64;

    // Limb 10: k10 + lo(p37..p73) + hi(p27..p72)
    let acc10: u64 = k10
        + (p37 % 4294967296u64) + (p46 % 4294967296u64) + (p55 % 4294967296u64)
        + (p64 % 4294967296u64) + (p73 % 4294967296u64)
        + (p27 / 4294967296u64) + (p36 / 4294967296u64) + (p45 / 4294967296u64)
        + (p54 / 4294967296u64) + (p63 / 4294967296u64) + (p72 / 4294967296u64);
    let m10_u64: u64 = acc10 % 4294967296u64;
    let m10: u32 = m10_u64 as u32;
    let k11: u64 = acc10 / 4294967296u64;

    // Limb 11: k11 + lo(p47..p74) + hi(p37..p73)
    let acc11: u64 = k11
        + (p47 % 4294967296u64) + (p56 % 4294967296u64)
        + (p65 % 4294967296u64) + (p74 % 4294967296u64)
        + (p37 / 4294967296u64) + (p46 / 4294967296u64) + (p55 / 4294967296u64)
        + (p64 / 4294967296u64) + (p73 / 4294967296u64);
    let m11_u64: u64 = acc11 % 4294967296u64;
    let m11: u32 = m11_u64 as u32;
    let k12: u64 = acc11 / 4294967296u64;

    // Limb 12: k12 + lo(p57..p75) + hi(p47..p74)
    let acc12: u64 = k12
        + (p57 % 4294967296u64) + (p66 % 4294967296u64) + (p75 % 4294967296u64)
        + (p47 / 4294967296u64) + (p56 / 4294967296u64) + (p65 / 4294967296u64) + (p74 / 4294967296u64);
    let m12_u64: u64 = acc12 % 4294967296u64;
    let m12: u32 = m12_u64 as u32;
    let k13: u64 = acc12 / 4294967296u64;

    // Limb 13: k13 + lo(p67, p76) + hi(p57, p66, p75)
    let acc13: u64 = k13
        + (p67 % 4294967296u64) + (p76 % 4294967296u64)
        + (p57 / 4294967296u64) + (p66 / 4294967296u64) + (p75 / 4294967296u64);
    let m13_u64: u64 = acc13 % 4294967296u64;
    let m13: u32 = m13_u64 as u32;
    let k14: u64 = acc13 / 4294967296u64;

    // Limb 14: k14 + lo(p77) + hi(p67, p76)
    let acc14: u64 = k14
        + (p77 % 4294967296u64)
        + (p67 / 4294967296u64) + (p76 / 4294967296u64);
    let m14_u64: u64 = acc14 % 4294967296u64;
    let m14: u32 = m14_u64 as u32;
    let k15: u64 = acc14 / 4294967296u64;

    // Limb 15: k15 + hi(p77). No further contributions; this is the top limb.
    let acc15: u64 = k15 + (p77 / 4294967296u64);
    let m15_u64: u64 = acc15 % 4294967296u64;
    let m15: u32 = m15_u64 as u32;

    (m0,  m1,  m2,  m3,  m4,  m5,  m6,  m7,
     m8,  m9,  m10, m11, m12, m13, m14, m15)
}

// felt252_montgomery_reduce: CIOS Montgomery reduction over the Stark prime.
//
// Takes a 16-limb (512-bit) integer T (typically the output of
// felt252_mul_raw) and returns T * R^-1 mod P as an 8-limb value, where
// R = 2^256. For Stark prime P, P mod 2^32 = 1 so P^-1 mod 2^32 = 1 and
// N' = -P^-1 mod 2^32 = 2^32 - 1. The m at each step is m_i = -T_i mod 2^32,
// computed via m_prod = T_i * (2^32 - 1) (truncated to low 32 bits).
//
// P limb-by-limb: (1, 0, 0, 0, 0, 0, 17, 2^27). So adding m*P at position i
// touches three limbs explicitly: i (m*1), i+6 (m*17), i+7 (m*2^27).
// Each m*const product is u64, split into low/high 32-bit halves that
// straddle the boundary at the destination limbs.
//
// After 8 iterations, result is held in limbs 8..15 of the working register.
// Standard Montgomery analysis gives result < 2P, so one conditional
// subtract of P brings it canonical. (A tighter bound proof is deferred.)

fn felt252_montgomery_reduce(
    m0:  u32, m1:  u32, m2:  u32, m3:  u32,
    m4:  u32, m5:  u32, m6:  u32, m7:  u32,
    m8:  u32, m9:  u32, m10: u32, m11: u32,
    m12: u32, m13: u32, m14: u32, m15: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32)
{
    // ===== Iteration 0: zero out limb 0, touches limbs 0..8 =====
    let n0: u32 = ((m0 as u64) * 4294967295u64) as u32;
    let n0_17: u64 = (n0 as u64) * 17u64;
    let n0_17_lo_u64: u64 = n0_17 % 4294967296u64;
    let n0_17_lo: u32 = n0_17_lo_u64 as u32;
    let n0_17_hi: u32 = (n0_17 / 4294967296u64) as u32;
    let n0_pow: u64 = (n0 as u64) * 134217728u64;
    let n0_pow_lo_u64: u64 = n0_pow % 4294967296u64;
    let n0_pow_lo: u32 = n0_pow_lo_u64 as u32;
    let n0_pow_hi: u32 = (n0_pow / 4294967296u64) as u32;

    let a00: u64 = (m0 as u64) + (n0 as u64);
    let k01: u64 = a00 / 4294967296u64;
    let a01: u64 = (m1 as u64) + k01;
    let t0_1_u64: u64 = a01 % 4294967296u64;
    let t0_1: u32 = t0_1_u64 as u32;
    let k02: u64 = a01 / 4294967296u64;
    let a02: u64 = (m2 as u64) + k02;
    let t0_2_u64: u64 = a02 % 4294967296u64;
    let t0_2: u32 = t0_2_u64 as u32;
    let k03: u64 = a02 / 4294967296u64;
    let a03: u64 = (m3 as u64) + k03;
    let t0_3_u64: u64 = a03 % 4294967296u64;
    let t0_3: u32 = t0_3_u64 as u32;
    let k04: u64 = a03 / 4294967296u64;
    let a04: u64 = (m4 as u64) + k04;
    let t0_4_u64: u64 = a04 % 4294967296u64;
    let t0_4: u32 = t0_4_u64 as u32;
    let k05: u64 = a04 / 4294967296u64;
    let a05: u64 = (m5 as u64) + k05;
    let t0_5_u64: u64 = a05 % 4294967296u64;
    let t0_5: u32 = t0_5_u64 as u32;
    let k06: u64 = a05 / 4294967296u64;
    let a06: u64 = (m6 as u64) + (n0_17_lo as u64) + k06;
    let t0_6_u64: u64 = a06 % 4294967296u64;
    let t0_6: u32 = t0_6_u64 as u32;
    let k07: u64 = a06 / 4294967296u64;
    let a07: u64 = (m7 as u64) + (n0_17_hi as u64) + (n0_pow_lo as u64) + k07;
    let t0_7_u64: u64 = a07 % 4294967296u64;
    let t0_7: u32 = t0_7_u64 as u32;
    let k08: u64 = a07 / 4294967296u64;
    let a08: u64 = (m8 as u64) + (n0_pow_hi as u64) + k08;
    let t0_8_u64: u64 = a08 % 4294967296u64;
    let t0_8: u32 = t0_8_u64 as u32;
    let k09: u64 = a08 / 4294967296u64;
    let a09: u64 = (m9 as u64) + k09;
    let t0_9_u64: u64 = a09 % 4294967296u64;
    let t0_9: u32 = t0_9_u64 as u32;
    let k0a: u64 = a09 / 4294967296u64;
    let a0a: u64 = (m10 as u64) + k0a;
    let t0_10_u64: u64 = a0a % 4294967296u64;
    let t0_10: u32 = t0_10_u64 as u32;
    let k0b: u64 = a0a / 4294967296u64;
    let a0b: u64 = (m11 as u64) + k0b;
    let t0_11_u64: u64 = a0b % 4294967296u64;
    let t0_11: u32 = t0_11_u64 as u32;
    let k0c: u64 = a0b / 4294967296u64;
    let a0c: u64 = (m12 as u64) + k0c;
    let t0_12_u64: u64 = a0c % 4294967296u64;
    let t0_12: u32 = t0_12_u64 as u32;
    let k0d: u64 = a0c / 4294967296u64;
    let a0d: u64 = (m13 as u64) + k0d;
    let t0_13_u64: u64 = a0d % 4294967296u64;
    let t0_13: u32 = t0_13_u64 as u32;
    let k0e: u64 = a0d / 4294967296u64;
    let a0e: u64 = (m14 as u64) + k0e;
    let t0_14_u64: u64 = a0e % 4294967296u64;
    let t0_14: u32 = t0_14_u64 as u32;
    let k0f: u64 = a0e / 4294967296u64;
    let a0f: u64 = (m15 as u64) + k0f;
    let t0_15_u64: u64 = a0f % 4294967296u64;
    let t0_15: u32 = t0_15_u64 as u32;
    let cap0: u64 = a0f / 4294967296u64;

    // ===== Iteration 1: zero out t0_1, touches limbs 1..9 =====
    let n1: u32 = ((t0_1 as u64) * 4294967295u64) as u32;
    let n1_17: u64 = (n1 as u64) * 17u64;
    let n1_17_lo_u64: u64 = n1_17 % 4294967296u64;
    let n1_17_lo: u32 = n1_17_lo_u64 as u32;
    let n1_17_hi: u32 = (n1_17 / 4294967296u64) as u32;
    let n1_pow: u64 = (n1 as u64) * 134217728u64;
    let n1_pow_lo_u64: u64 = n1_pow % 4294967296u64;
    let n1_pow_lo: u32 = n1_pow_lo_u64 as u32;
    let n1_pow_hi: u32 = (n1_pow / 4294967296u64) as u32;

    let b01: u64 = (t0_1 as u64) + (n1 as u64);
    let k12: u64 = b01 / 4294967296u64;
    let b02: u64 = (t0_2 as u64) + k12;
    let t1_2_u64: u64 = b02 % 4294967296u64;
    let t1_2: u32 = t1_2_u64 as u32;
    let k13: u64 = b02 / 4294967296u64;
    let b03: u64 = (t0_3 as u64) + k13;
    let t1_3_u64: u64 = b03 % 4294967296u64;
    let t1_3: u32 = t1_3_u64 as u32;
    let k14: u64 = b03 / 4294967296u64;
    let b04: u64 = (t0_4 as u64) + k14;
    let t1_4_u64: u64 = b04 % 4294967296u64;
    let t1_4: u32 = t1_4_u64 as u32;
    let k15: u64 = b04 / 4294967296u64;
    let b05: u64 = (t0_5 as u64) + k15;
    let t1_5_u64: u64 = b05 % 4294967296u64;
    let t1_5: u32 = t1_5_u64 as u32;
    let k16: u64 = b05 / 4294967296u64;
    let b06: u64 = (t0_6 as u64) + k16;
    let t1_6_u64: u64 = b06 % 4294967296u64;
    let t1_6: u32 = t1_6_u64 as u32;
    let k17: u64 = b06 / 4294967296u64;
    let b07: u64 = (t0_7 as u64) + (n1_17_lo as u64) + k17;
    let t1_7_u64: u64 = b07 % 4294967296u64;
    let t1_7: u32 = t1_7_u64 as u32;
    let k18: u64 = b07 / 4294967296u64;
    let b08: u64 = (t0_8 as u64) + (n1_17_hi as u64) + (n1_pow_lo as u64) + k18;
    let t1_8_u64: u64 = b08 % 4294967296u64;
    let t1_8: u32 = t1_8_u64 as u32;
    let k19: u64 = b08 / 4294967296u64;
    let b09: u64 = (t0_9 as u64) + (n1_pow_hi as u64) + k19;
    let t1_9_u64: u64 = b09 % 4294967296u64;
    let t1_9: u32 = t1_9_u64 as u32;
    let k1a: u64 = b09 / 4294967296u64;
    let b0a: u64 = (t0_10 as u64) + k1a;
    let t1_10_u64: u64 = b0a % 4294967296u64;
    let t1_10: u32 = t1_10_u64 as u32;
    let k1b: u64 = b0a / 4294967296u64;
    let b0b: u64 = (t0_11 as u64) + k1b;
    let t1_11_u64: u64 = b0b % 4294967296u64;
    let t1_11: u32 = t1_11_u64 as u32;
    let k1c: u64 = b0b / 4294967296u64;
    let b0c: u64 = (t0_12 as u64) + k1c;
    let t1_12_u64: u64 = b0c % 4294967296u64;
    let t1_12: u32 = t1_12_u64 as u32;
    let k1d: u64 = b0c / 4294967296u64;
    let b0d: u64 = (t0_13 as u64) + k1d;
    let t1_13_u64: u64 = b0d % 4294967296u64;
    let t1_13: u32 = t1_13_u64 as u32;
    let k1e: u64 = b0d / 4294967296u64;
    let b0e: u64 = (t0_14 as u64) + k1e;
    let t1_14_u64: u64 = b0e % 4294967296u64;
    let t1_14: u32 = t1_14_u64 as u32;
    let k1f: u64 = b0e / 4294967296u64;
    let b0f: u64 = (t0_15 as u64) + cap0 + k1f;
    let t1_15_u64: u64 = b0f % 4294967296u64;
    let t1_15: u32 = t1_15_u64 as u32;
    let cap1: u64 = b0f / 4294967296u64;

    // ===== Iteration 2: zero out t1_2, touches limbs 2..10 =====
    let n2: u32 = ((t1_2 as u64) * 4294967295u64) as u32;
    let n2_17: u64 = (n2 as u64) * 17u64;
    let n2_17_lo_u64: u64 = n2_17 % 4294967296u64;
    let n2_17_lo: u32 = n2_17_lo_u64 as u32;
    let n2_17_hi: u32 = (n2_17 / 4294967296u64) as u32;
    let n2_pow: u64 = (n2 as u64) * 134217728u64;
    let n2_pow_lo_u64: u64 = n2_pow % 4294967296u64;
    let n2_pow_lo: u32 = n2_pow_lo_u64 as u32;
    let n2_pow_hi: u32 = (n2_pow / 4294967296u64) as u32;

    let c02: u64 = (t1_2 as u64) + (n2 as u64);
    let k23: u64 = c02 / 4294967296u64;
    let c03: u64 = (t1_3 as u64) + k23;
    let t2_3_u64: u64 = c03 % 4294967296u64;
    let t2_3: u32 = t2_3_u64 as u32;
    let k24: u64 = c03 / 4294967296u64;
    let c04: u64 = (t1_4 as u64) + k24;
    let t2_4_u64: u64 = c04 % 4294967296u64;
    let t2_4: u32 = t2_4_u64 as u32;
    let k25: u64 = c04 / 4294967296u64;
    let c05: u64 = (t1_5 as u64) + k25;
    let t2_5_u64: u64 = c05 % 4294967296u64;
    let t2_5: u32 = t2_5_u64 as u32;
    let k26: u64 = c05 / 4294967296u64;
    let c06: u64 = (t1_6 as u64) + k26;
    let t2_6_u64: u64 = c06 % 4294967296u64;
    let t2_6: u32 = t2_6_u64 as u32;
    let k27: u64 = c06 / 4294967296u64;
    let c07: u64 = (t1_7 as u64) + k27;
    let t2_7_u64: u64 = c07 % 4294967296u64;
    let t2_7: u32 = t2_7_u64 as u32;
    let k28: u64 = c07 / 4294967296u64;
    let c08: u64 = (t1_8 as u64) + (n2_17_lo as u64) + k28;
    let t2_8_u64: u64 = c08 % 4294967296u64;
    let t2_8: u32 = t2_8_u64 as u32;
    let k29: u64 = c08 / 4294967296u64;
    let c09: u64 = (t1_9 as u64) + (n2_17_hi as u64) + (n2_pow_lo as u64) + k29;
    let t2_9_u64: u64 = c09 % 4294967296u64;
    let t2_9: u32 = t2_9_u64 as u32;
    let k2a: u64 = c09 / 4294967296u64;
    let c0a: u64 = (t1_10 as u64) + (n2_pow_hi as u64) + k2a;
    let t2_10_u64: u64 = c0a % 4294967296u64;
    let t2_10: u32 = t2_10_u64 as u32;
    let k2b: u64 = c0a / 4294967296u64;
    let c0b: u64 = (t1_11 as u64) + k2b;
    let t2_11_u64: u64 = c0b % 4294967296u64;
    let t2_11: u32 = t2_11_u64 as u32;
    let k2c: u64 = c0b / 4294967296u64;
    let c0c: u64 = (t1_12 as u64) + k2c;
    let t2_12_u64: u64 = c0c % 4294967296u64;
