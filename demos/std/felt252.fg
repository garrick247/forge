    let t7_15: u32 = t7_15_u64 as u32;
    // cap7 = h0f / 4294967296u64 — final overflow bit. In CIOS Montgomery the
    // intermediate value is < 2P*R, so after the >>R shift the result is
    // < 2P, and cap7 ∈ {0, 1} acts as the "high bit" beyond limb 15.

    // ===== Conditional subtract P =====
    // The 8-limb candidate result is (t7_8..t7_15). Tentatively compute
