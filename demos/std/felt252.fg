const POSEIDON_MDS_20_1: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_20_2: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_20_3: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_20_4: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_20_5: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_20_6: u32 = 4294966768u32;  // 0xFFFFFDF0
