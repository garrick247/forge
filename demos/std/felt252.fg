    let r11: u32 = mul_raw_limb_11(a0, a1, a2, a3, a4, a5, a6, a7, b0, b1, b2, b3, b4, b5, b6, b7);
    let r12: u32 = mul_raw_limb_12(a0, a1, a2, a3, a4, a5, a6, a7, b0, b1, b2, b3, b4, b5, b6, b7);
    let r13: u32 = mul_raw_limb_13(a0, a1, a2, a3, a4, a5, a6, a7, b0, b1, b2, b3, b4, b5, b6, b7);
    let r14: u32 = mul_raw_limb_14(a0, a1, a2, a3, a4, a5, a6, a7, b0, b1, b2, b3, b4, b5, b6, b7);
    let r15: u32 = mul_raw_limb_15(a0, a1, a2, a3, a4, a5, a6, a7, b0, b1, b2, b3, b4, b5, b6, b7);
    (r0,  r1,  r2,  r3,  r4,  r5,  r6,  r7,
     r8,  r9,  r10, r11, r12, r13, r14, r15)
}



// ==== Per-iteration Montgomery reduce (math-correctness layer) =====
// 8 separate mont_iter_K functions, each with the verified invariant
// `result.K == 0u32` after iteration K. The composition
// `felt252_montgomery_reduce_v2` chains them with the prior-iteration
// cap propagation and the final conditional-subtract of P.

// ---- Per-iteration Montgomery reduce with limb-zeroing invariant ---
// Each mont_iter_K function operates on a 16-limb state + an incoming
// cap carry, and outputs the 16-limb post-iteration state + outgoing
// cap carry. Verified ensures: result.K == 0u32 (the limb this
// iteration zeroes out). The full 8-iteration Montgomery reduce
// composes them sequentially with cap_in=0u64 for iteration 0.

// Montgomery iteration 0: zeroes out limb 0.
fn mont_iter_0(
    t0:  u32, t1:  u32, t2:  u32, t3:  u32,
    t4:  u32, t5:  u32, t6:  u32, t7:  u32,
    t8:  u32, t9:  u32, t10: u32, t11: u32,
    t12: u32, t13: u32, t14: u32, t15: u32,
    cap_in: u64
) -> (u32, u32, u32, u32, u32, u32, u32, u32,
      u32, u32, u32, u32, u32, u32, u32, u32, u64)
    requires cap_in <= 1u64
    ensures result.0 == 0u32
    ensures result.16 <= 1u64
{
    // m = t0 * N' mod 2^32, where N' = 2^32 - 1.
    let m_prod: u64 = (t0 as u64) * 4294967295u64;
    let m_u64: u64 = m_prod % 4294967296u64;
    let m: u32 = m_u64 as u32;
    let m17: u64 = (m as u64) * 17u64;
    let m17_lo: u32 = (m17 % 4294967296u64) as u32;
    let m17_hi: u32 = (m17 / 4294967296u64) as u32;
    let mpow: u64 = (m as u64) * 134217728u64;
    let mpow_lo: u32 = (mpow % 4294967296u64) as u32;
    let mpow_hi: u32 = (mpow / 4294967296u64) as u32;

    let acc0: u64 = (t0 as u64) + (m as u64);
    let new_t0_u64: u64 = acc0 % 4294967296u64;
    let new_t0: u32 = new_t0_u64 as u32;
    let k1: u64 = acc0 / 4294967296u64;
    let acc1: u64 = (t1 as u64) + k1;
    let new_t1_u64: u64 = acc1 % 4294967296u64;
    let new_t1: u32 = new_t1_u64 as u32;
    let k2: u64 = acc1 / 4294967296u64;
    let acc2: u64 = (t2 as u64) + k2;
    let new_t2_u64: u64 = acc2 % 4294967296u64;
    let new_t2: u32 = new_t2_u64 as u32;
    let k3: u64 = acc2 / 4294967296u64;
    let acc3: u64 = (t3 as u64) + k3;
    let new_t3_u64: u64 = acc3 % 4294967296u64;
    let new_t3: u32 = new_t3_u64 as u32;
    let k4: u64 = acc3 / 4294967296u64;
    let acc4: u64 = (t4 as u64) + k4;
    let new_t4_u64: u64 = acc4 % 4294967296u64;
    let new_t4: u32 = new_t4_u64 as u32;
    let k5: u64 = acc4 / 4294967296u64;
    let acc5: u64 = (t5 as u64) + k5;
    let new_t5_u64: u64 = acc5 % 4294967296u64;
    let new_t5: u32 = new_t5_u64 as u32;
    let k6: u64 = acc5 / 4294967296u64;
    let acc6: u64 = (t6 as u64) + (m17_lo as u64) + k6;
    let new_t6_u64: u64 = acc6 % 4294967296u64;
    let new_t6: u32 = new_t6_u64 as u32;
    let k7: u64 = acc6 / 4294967296u64;
    let acc7: u64 = (t7 as u64) + (m17_hi as u64) + (mpow_lo as u64) + k7;
    let new_t7_u64: u64 = acc7 % 4294967296u64;
    let new_t7: u32 = new_t7_u64 as u32;
    let k8: u64 = acc7 / 4294967296u64;
    let acc8: u64 = (t8 as u64) + (mpow_hi as u64) + k8;
    let new_t8_u64: u64 = acc8 % 4294967296u64;
    let new_t8: u32 = new_t8_u64 as u32;
    let k9: u64 = acc8 / 4294967296u64;
    let acc9: u64 = (t9 as u64) + k9;
    let new_t9_u64: u64 = acc9 % 4294967296u64;
    let new_t9: u32 = new_t9_u64 as u32;
    let k10: u64 = acc9 / 4294967296u64;
    let acc10: u64 = (t10 as u64) + k10;
    let new_t10_u64: u64 = acc10 % 4294967296u64;
    let new_t10: u32 = new_t10_u64 as u32;
    let k11: u64 = acc10 / 4294967296u64;
    let acc11: u64 = (t11 as u64) + k11;
    let new_t11_u64: u64 = acc11 % 4294967296u64;
    let new_t11: u32 = new_t11_u64 as u32;
    let k12: u64 = acc11 / 4294967296u64;
    let acc12: u64 = (t12 as u64) + k12;
    let new_t12_u64: u64 = acc12 % 4294967296u64;
    let new_t12: u32 = new_t12_u64 as u32;
    let k13: u64 = acc12 / 4294967296u64;
    let acc13: u64 = (t13 as u64) + k13;
    let new_t13_u64: u64 = acc13 % 4294967296u64;
    let new_t13: u32 = new_t13_u64 as u32;
    let k14: u64 = acc13 / 4294967296u64;
    let acc14: u64 = (t14 as u64) + k14;
    let new_t14_u64: u64 = acc14 % 4294967296u64;
    let new_t14: u32 = new_t14_u64 as u32;
    let k15: u64 = acc14 / 4294967296u64;
    let acc15: u64 = (t15 as u64) + k15 + cap_in;
    let new_t15_u64: u64 = acc15 % 4294967296u64;
    let new_t15: u32 = new_t15_u64 as u32;
    let cap_out: u64 = acc15 / 4294967296u64;
    (new_t0,  new_t1,  new_t2,  new_t3,
     new_t4,  new_t5,  new_t6,  new_t7,
     new_t8,  new_t9,  new_t10, new_t11,
     new_t12, new_t13, new_t14, new_t15, cap_out)
}

