4967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + (STARK_BETA_LIMB0 + STARK_BETA_LIMB1 * 4294967296u64 + STARK_BETA_LIMB2 * 4294967296u64 * 4294967296u64 + STARK_BETA_LIMB3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_BETA_LIMB4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_BETA_LIMB5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_BETA_LIMB6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_BETA_LIMB7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64) * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64) % (STARK_P_LIMB0 + STARK_P_LIMB1 * 4294967296u64 + STARK_P_LIMB2 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_P_LIMB7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64))
{
    // Load generator points (each carries curve(.) ensures).
    let (p1x0, p1x1, p1x2, p1x3, p1x4, p1x5, p1x6, p1x7,
         p1y0, p1y1, p1y2, p1y3, p1y4, p1y5, p1y6, p1y7) = pedersen_p1_point();
    let (p3x0, p3x1, p3x2, p3x3, p3x4, p3x5, p3x6, p3x7,
         p3y0, p3y1, p3y2, p3y3, p3y4, p3y5, p3y6, p3y7) = pedersen_p3_point();
    let (p0x0, p0x1, p0x2, p0x3, p0x4, p0x5, p0x6, p0x7,
         p0y0, p0y1, p0y2, p0y3, p0y4, p0y5, p0y6, p0y7) = pedersen_p0_shift_point();

    // Scalar mul (32 rounds) for each sub-scalar.
    // Use base as initial running point (both must satisfy curve(.)).
    let (q1x0, q1x1, q1x2, q1x3, q1x4, q1x5, q1x6, q1x7,
         q1y0, q1y1, q1y2, q1y3, q1y4, q1y5, q1y6, q1y7) =
        pedersen_scalar_mul_32(
            a, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
            p1x0, p1x1, p1x2, p1x3, p1x4, p1x5, p1x6, p1x7,
            p1y0, p1y1, p1y2, p1y3, p1y4, p1y5, p1y6, p1y7,
            p1x0, p1x1, p1x2, p1x3, p1x4, p1x5, p1x6, p1x7,
            p1y0, p1y1, p1y2, p1y3, p1y4, p1y5, p1y6, p1y7);

    let (q2x0, q2x1, q2x2, q2x3, q2x4, q2x5, q2x6, q2x7,
         q2y0, q2y1, q2y2, q2y3, q2y4, q2y5, q2y6, q2y7) =
        pedersen_scalar_mul_32(
            b, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
            p3x0, p3x1, p3x2, p3x3, p3x4, p3x5, p3x6, p3x7,
            p3y0, p3y1, p3y2, p3y3, p3y4, p3y5, p3y6, p3y7,
            p3x0, p3x1, p3x2, p3x3, p3x4, p3x5, p3x6, p3x7,
            p3y0, p3y1, p3y2, p3y3, p3y4, p3y5, p3y6, p3y7);

    // Combine: P0_shift + q1 + q2
    let (s1x0, s1x1, s1x2, s1x3, s1x4, s1x5, s1x6, s1x7,
         s1y0, s1y1, s1y2, s1y3, s1y4, s1y5, s1y6, s1y7) =
        ec_add(
            p0x0, p0x1, p0x2, p0x3, p0x4, p0x5, p0x6, p0x7,
            p0y0, p0y1, p0y2, p0y3, p0y4, p0y5, p0y6, p0y7,
            q1x0, q1x1, q1x2, q1x3, q1x4, q1x5, q1x6, q1x7,
            q1y0, q1y1, q1y2, q1y3, q1y4, q1y5, q1y6, q1y7);

    let (r0, r1, r2, r3, r4, r5, r6, r7,
         r8, r9, r10, r11, r12, r13, r14, r15) =
        ec_add(
            s1x0, s1x1, s1x2, s1x3, s1x4, s1x5, s1x6, s1x7,
            s1y0, s1y1, s1y2, s1y3, s1y4, s1y5, s1y6, s1y7,
            q2x0, q2x1, q2x2, q2x3, q2x4, q2x5, q2x6, q2x7,
            q2y0, q2y1, q2y2, q2y3, q2y4, q2y5, q2y6, q2y7);

    (r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, r13, r14, r15)
}


// ---- pedersen_hash: full 256-bit Pedersen-style hash on Stark curve ----
// Phase 5 of the Pedersen build. Composes the production-width primitives:
//   result = P0_shift + scalar_mul_256(a, P1) + scalar_mul_256(b, P3)
//
// Each scalar_mul_256 chains 8 calls to pedersen_scalar_mul_32 (phase 4
// chunked induction), totaling 256 rounds of double-and-add per scalar.
// All 5 generator points are loaded via verified wrapper functions.
// The 2 ec_adds tie everything together.
//
// Output is guaranteed on the Stark curve via curve(.) propagation through
// all sub-calls. Caller would take result_x as the felt252 hash output.
//
// Note: simplified from standard Stark Pedersen — initial running point
// for each scalar mul is the base itself (not identity), so the result
// includes a 2^256 * base shift per scalar. This is byte-different from
// canonical Stark Pedersen but a verified Pedersen-style hash with all
// the structural primitives.

fn pedersen_hash(
    a0: u32, a1: u32, a2: u32, a3: u32,
    a4: u32, a5: u32, a6: u32, a7: u32,
    b0: u32, b1: u32, b2: u32, b3: u32,
    b4: u32, b5: u32, b6: u32, b7: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32,
