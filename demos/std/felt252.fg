    let k12: u64 = acc11 / 4294967296u64;
    let acc12: u64 = (t12 as u64) + (m17_lo as u64) + k12;
    let new_t12_u64: u64 = acc12 % 4294967296u64;
    let new_t12: u32 = new_t12_u64 as u32;
    let k13: u64 = acc12 / 4294967296u64;
    let acc13: u64 = (t13 as u64) + (m17_hi as u64) + (mpow_lo as u64) + k13;
    let new_t13_u64: u64 = acc13 % 4294967296u64;
