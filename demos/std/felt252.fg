const POSEIDON_MDS_01_1: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_01_2: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_01_3: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_01_4: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_01_5: u32 = 4294967295u32;  // 0xFFFFFFFF
const POSEIDON_MDS_01_6: u32 = 4294966768u32;  // 0xFFFFFDF0
const POSEIDON_MDS_01_7: u32 = 134217727u32;  // 0x07FFFFFF

// MDS[0][2] canonical = 1
