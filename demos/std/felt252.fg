        pedersen_p0_shift_point();

    // Scalar mul: scalar_mul_256(scalar, SHIFT, base) = 2^256*SHIFT + scalar*base.
    let (qx0, qx1, qx2, qx3, qx4, qx5, qx6, qx7,
         qy0, qy1, qy2, qy3, qy4, qy5, qy6, qy7) =
        pedersen_scalar_mul_256(
            s0, s1, s2, s3, s4, s5, s6, s7,
            sx0, sx1, sx2, sx3, sx4, sx5, sx6, sx7,
            sy0, sy1, sy2, sy3, sy4, sy5, sy6, sy7,
            bx0, bx1, bx2, bx3, bx4, bx5, bx6, bx7,
            by0, by1, by2, by3, by4, by5, by6, by7);

    // Load SHIFT_256 = 2^256 * SHIFT.
    let (kx0, kx1, kx2, kx3, kx4, kx5, kx6, kx7,
         ky0, ky1, ky2, ky3, ky4, ky5, ky6, ky7) =
        pedersen_shift_256_point();

    // ec_sub: result = q - SHIFT_256 = scalar * base.
    let (r0, r1, r2, r3, r4, r5, r6, r7,
         r8, r9, r10, r11, r12, r13, r14, r15) =
        ec_sub(
            qx0, qx1, qx2, qx3, qx4, qx5, qx6, qx7,
            qy0, qy1, qy2, qy3, qy4, qy5, qy6, qy7,
            kx0, kx1, kx2, kx3, kx4, kx5, kx6, kx7,
            ky0, ky1, ky2, ky3, ky4, ky5, ky6, ky7);

    (r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, r13, r14, r15)
}


// ---- pedersen_canonical: canonical Stark Pedersen 2-scalar hash ---------
// Uses pedersen_scalar_mul_canonical to get true scalar*base values
// (without the 2^256*SHIFT offset from phase 5). Output is structurally
// closer to spec Stark Pedersen, modulo the 248+4-bit input split which
// remains as full 256-bit here.

fn pedersen_canonical(
    a0: u32, a1: u32, a2: u32, a3: u32,
    a4: u32, a5: u32, a6: u32, a7: u32,
    b0: u32, b1: u32, b2: u32, b3: u32,
    b4: u32, b5: u32, b6: u32, b7: u32
