            HADES_RC_86_2_0, HADES_RC_86_2_1, HADES_RC_86_2_2, HADES_RC_86_2_3, HADES_RC_86_2_4, HADES_RC_86_2_5, HADES_RC_86_2_6, HADES_RC_86_2_7);

    // === 4 full rounds (end) ===
    let (r88s0_0, r88s0_1, r88s0_2, r88s0_3, r88s0_4, r88s0_5, r88s0_6, r88s0_7, r88s1_0, r88s1_1, r88s1_2, r88s1_3, r88s1_4, r88s1_5, r88s1_6, r88s1_7, r88s2_0, r88s2_1, r88s2_2, r88s2_3, r88s2_4, r88s2_5, r88s2_6, r88s2_7) =
