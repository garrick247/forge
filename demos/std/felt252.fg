// (the canonical Stark curve beta; alpha = 1 is implicit)
const STARK_BETA_LIMB0: u32 = 2632883849u32;  // 0x9CEE9E89
const STARK_BETA_LIMB1: u32 = 4107140281u32;  // 0xF4CDFCB9
const STARK_BETA_LIMB2: u32 = 365499841u32;  // 0x15C915C1
const STARK_BETA_LIMB3: u32 = 1620759148u32;  // 0x609AD26C
