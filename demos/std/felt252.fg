// std/felt252.fg -- Stark base-field arithmetic (252-bit modular).
//
// Stark prime:  P = 2^251 + 17 * 2^192 + 1
//             = 0x800000000000011000000000000000000000000000000000000000000000001
//             = 3618502788666131213697322783095070105623107215331596699973092056135872020481
//
// Used by Cairo, StarkNet, and stwo's Pedersen / EC operations.
//
// Representation: 8 limbs of u32, LSB-first.
//   value = sum_{i=0..8} limb[i] * 2^(32*i)
//   Top limb constrained to < 2^28 (since 252 = 7*32 + 28).
//
// Field invariant: (limb[0..8]) lex-less-than (P[0..8]).
//
// This file establishes the field constants and a verified 2-limb add as
// a proof of correctness for the carry-chain pattern. Full 8-limb add /
// sub / mul / inv are tee-d up as a follow-up — each requires a careful
// chunked-proof structure.

// ---- Stark prime, limb-by-limb (LSB first) ---------------------------------
// P = 2^251 + 17*2^192 + 1
//
// Bit pattern (bits 0..256 LSB-first):
//   bit   0       set (the +1)
//   bit 192       set
//   bit 196       set    (17 = 0x11 = bit 0 + bit 4 of the multiplier on 2^192)
//   bit 251       set
//
// Limbs:
//   limb[0] = 0x00000001   (bit 0)
//   limb[1] = 0x00000000
//   limb[2] = 0x00000000
//   limb[3] = 0x00000000
//   limb[4] = 0x00000000
//   limb[5] = 0x00000000
//   limb[6] = 0x00000011   (bits 192, 196)
//   limb[7] = 0x08000000   (bit 251 within top limb's bit 27)
const STARK_P_LIMB0: u32 = 1u32;
const STARK_P_LIMB1: u32 = 0u32;
const STARK_P_LIMB2: u32 = 0u32;
const STARK_P_LIMB3: u32 = 0u32;
const STARK_P_LIMB4: u32 = 0u32;
const STARK_P_LIMB5: u32 = 0u32;
const STARK_P_LIMB6: u32 = 17u32;
const STARK_P_LIMB7: u32 = 134217728u32;   // 2^27 = 0x08000000

// Top-limb maximum: 2^28 - 1 = 0x0FFFFFFF (since top contains bits 224..251)
const STARK_LIMB_TOP_MAX: u32 = 268435455u32;

// ---- Carry-chain primitives ------------------------------------------------
// add_with_carry(a, b, c_in) returns (sum_low_32_bits, carry_out_0_or_1).
// Used as the building block for multi-limb addition.
//
// Spec:  a + b + c_in = sum + carry_out * 2^32
//        sum < 2^32, carry_out in {0, 1}.

fn add_with_carry_sum(a: u32, b: u32, c_in: u32) -> u32
    requires c_in < 2u32
{
    let s64: u64 = (a as u64) + (b as u64) + (c_in as u64);
    s64 as u32
}

fn add_with_carry_out(a: u32, b: u32, c_in: u32) -> u32
    requires c_in < 2u32
    ensures result < 2u32
{
    let s64: u64 = (a as u64) + (b as u64) + (c_in as u64);
    // Direct case-split avoids Z3 needing to derive (s64 >> 32) < 2 from the bounds.
    if s64 >= 4294967296u64 { 1u32 } else { 0u32 }
}

// ---- Subtraction with borrow ----------------------------------------------
// sub_with_borrow(a, b, b_in) returns (diff_low_32_bits, borrow_out_0_or_1).
// Spec:  a - b - b_in = diff - borrow_out * 2^32
//
// Computed via two's complement: diff = a + (~b) + (1 - b_in), the carry-out
// of which is the inverse of the borrow-out.

fn sub_with_borrow_diff(a: u32, b: u32, b_in: u32) -> u32
    requires b_in < 2u32
{
    let a64: u64 = a as u64;
    let b64: u64 = b as u64;
    let bi: u64 = b_in as u64;
    // Add 2^32 to ensure non-negative subtraction within u64
    let s64: u64 = a64 + (4294967296u64 - b64 - bi);
    s64 as u32
}

fn sub_with_borrow_out(a: u32, b: u32, b_in: u32) -> u32
    requires b_in < 2u32
    ensures result < 2u32
{
    let a64: u64 = a as u64;
    let b64: u64 = b as u64;
    let bi: u64 = b_in as u64;
    // borrow_out = 1 iff (a < b + b_in)
    let r: u64 = if a64 < b64 + bi { 1u64 } else { 0u64 };
    r as u32
}

// ---- 2-limb (64-bit value) modular add over P_HI = 2^32 -------------------
// Demo of the carry-chain pattern over a 2-limb representation.
// This is NOT modular over the Stark prime — it's modular over a chosen
// 2-limb modulus to demonstrate the proof structure. Extending to 8-limb
// follows the same pattern with 8 add_with_carry calls and a final
// conditional reduction.

const DEMO_P_LIMB0: u32 = 4294967295u32;  // 0xFFFFFFFF
const DEMO_P_LIMB1: u32 = 0u32;            // P = 2^32 - 1, well-known Mersenne

fn felt2_add_demo_limb0(a0: u32, b0: u32) -> u32
{
    add_with_carry_sum(a0, b0, 0u32)
}

fn felt2_add_demo_limb1(a0: u32, b0: u32, a1: u32, b1: u32) -> u32
{
    let c0: u32 = add_with_carry_out(a0, b0, 0u32);
    add_with_carry_sum(a1, b1, c0)
}

// ---- TODO (not yet implemented) -------------------------------------------
// felt252_add(a_limbs[8], b_limbs[8]) -> result_limbs[8]
//   Apply add_with_carry_sum/out across 8 limbs (LSB to MSB), then
//   conditional subtract STARK_P if result >= P. Z3 obligations:
//   - each limb result < 2^32 (free from u32 type)
//   - top limb result <= STARK_LIMB_TOP_MAX after reduction
//   - lex-less-than P after final conditional sub
//
// felt252_sub(a, b) -> a - b (mod P)
//   Borrow chain across 8 limbs, conditional add P if borrow_out == 1.
//
// felt252_mul(a, b) -> a*b (mod P)
//   Schoolbook 8x8 = 16-limb product, then Solinas reduction using
//   2^251 = -17*2^192 - 1 (mod P) folded into the upper 8 limbs.
//
// felt252_inv(a) -> a^(P-2) (mod P)
//   Square-and-multiply ladder, ~252 steps. Each step uses felt252_mul.
//
// Each operation's Z3 proof requires explicit carry-tracking lemmas
// (similar to standard bignum arithmetic verification — see e.g.
// Fiat-Cryptography or Vale-Crypto). Not a one-shot port.

fn main() -> u64 { 0u64 }
