    let (r85s0_0, r85s0_1, r85s0_2, r85s0_3, r85s0_4, r85s0_5, r85s0_6, r85s0_7, r85s1_0, r85s1_1, r85s1_2, r85s1_3, r85s1_4, r85s1_5, r85s1_6, r85s1_7, r85s2_0, r85s2_1, r85s2_2, r85s2_3, r85s2_4, r85s2_5, r85s2_6, r85s2_7) =
