    // m = t6 * N' mod 2^32, where N' = 2^32 - 1.
    let m_prod: u64 = (t6 as u64) * 4294967295u64;
    let m_u64: u64 = m_prod % 4294967296u64;
    let m: u32 = m_u64 as u32;
