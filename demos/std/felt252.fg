    let d1: u32 = sub_with_borrow_diff(a1, b1, bo0);
    let bo1: u32 = sub_with_borrow_out(a1, b1, bo0);
    let d2: u32 = sub_with_borrow_diff(a2, b2, bo1);
    let bo2: u32 = sub_with_borrow_out(a2, b2, bo1);
    let d3: u32 = sub_with_borrow_diff(a3, b3, bo2);
    let bo3: u32 = sub_with_borrow_out(a3, b3, bo2);
    let d4: u32 = sub_with_borrow_diff(a4, b4, bo3);
    let bo4: u32 = sub_with_borrow_out(a4, b4, bo3);
    let d5: u32 = sub_with_borrow_diff(a5, b5, bo4);
    let bo5: u32 = sub_with_borrow_out(a5, b5, bo4);
    let d6: u32 = sub_with_borrow_diff(a6, b6, bo5);
    let bo6: u32 = sub_with_borrow_out(a6, b6, bo5);
    let d7: u32 = sub_with_borrow_diff(a7, b7, bo6);
    let bo7: u32 = sub_with_borrow_out(a7, b7, bo6);

