// ---- felt_n_mul: mod-n multiplication via mirrored Mont reduce ----------
// Composes the modulus-agnostic felt252_mul_raw (16-limb schoolbook
// integer product) with felt_n_montgomery_reduce_v2 (mod-n Mont reduce
// generated from the proven mod-P version).

fn felt_n_mul(
    a0: u32, a1: u32, a2: u32, a3: u32,
    a4: u32, a5: u32, a6: u32, a7: u32,
    b0: u32, b1: u32, b2: u32, b3: u32,
    b4: u32, b5: u32, b6: u32, b7: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32)
{
    let (p0,  p1,  p2,  p3,  p4,  p5,  p6,  p7,
         p8,  p9,  p10, p11, p12, p13, p14, p15) =
        felt252_mul_raw(a0, a1, a2, a3, a4, a5, a6, a7,
                        b0, b1, b2, b3, b4, b5, b6, b7);
    felt_n_montgomery_reduce_v2(p0,  p1,  p2,  p3,  p4,  p5,  p6,  p7,
                                p8,  p9,  p10, p11, p12, p13, p14, p15)
}


// ---- felt_n_sqr: mod-n squaring ----------------------------------------
fn felt_n_sqr(
    a0: u32, a1: u32, a2: u32, a3: u32,
    a4: u32, a5: u32, a6: u32, a7: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32)
{
    felt_n_mul(a0, a1, a2, a3, a4, a5, a6, a7,
               a0, a1, a2, a3, a4, a5, a6, a7)
}

// ---- felt_n_inv: mod-n modular inverse via Fermat -------------------
// Mirror of felt252_inv but with exponent (n-2) instead of (P-2).
// Square-and-multiply chain reflects binary of n-2:
//   n-2 bits = 252 (251 squarings + 127 muls-with-a = 378 operations).
// Audit-assume for the inverse identity in Mont form.

fn felt_n_inv(
    a0: u32, a1: u32, a2: u32, a3: u32,
    a4: u32, a5: u32, a6: u32, a7: u32
) -> (u32, u32, u32, u32, u32, u32, u32, u32)
    ensures ((result.0 + result.1 * 4294967296u64 + result.2 * 4294967296u64 * 4294967296u64 + result.3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + result.7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64) * (a0 + a1 * 4294967296u64 + a2 * 4294967296u64 * 4294967296u64 + a3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + a7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64)) % (STARK_N_LIMB0 + STARK_N_LIMB1 * 4294967296u64 + STARK_N_LIMB2 * 4294967296u64 * 4294967296u64 + STARK_N_LIMB3 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_N_LIMB4 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_N_LIMB5 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_N_LIMB6 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 + STARK_N_LIMB7 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64) == (4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64 * 4294967296u64) % (STARK_N_LIMB0 + STARK_N_LIMB1 * 4294967296u64 + STARK_N_LIMB2 * 4294967296u64 * 4294967296u64 + STARK_N_LIMB3 * 42949672