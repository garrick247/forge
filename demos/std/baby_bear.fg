// std/baby_bear.fg -- BabyBear field arithmetic + degree-4 binomial extension
//
// BabyBear = Z/(2^31 - 2^27 + 1)Z       p = 2013265921
// Used by Plonky3, SP1, and the wider Plonky3-ecosystem of provers.
//
// Extension is BabyBear[a]/(a^4 - 11), per Plonky3's canonical choice.
// Element repr: (c0, c1, c2, c3), value = c0 + c1*a + c2*a^2 + c3*a^3.
//
// Elements are represented as u32 with the invariant val < BABY_BEAR_P.
// Multiplication uses a u64 intermediate with `% P` (Z3-friendly; the C
// compiler reduces this to a Barrett or Montgomery sequence for GPU
// performance — the source-level proof is independent of the lowering).
//
// All functions are proven correct by Z3 (bitvector mode).
//
// Include with:  use std::baby_bear;

const BABY_BEAR_P: u32 = 2013265921u32;   // 2^31 - 2^27 + 1
const BABY_BEAR_W: u32 = 11u32;           // a^4 = 11 in the extension

// ---- BabyBear arithmetic ---------------------------------------------------

// Addition mod P. At most one conditional subtract needed since a+b < 2P.
fn baby_bear_add(a: u32, b: u32) -> u32
    requires a < BABY_BEAR_P
    requires b < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (a + b) % BABY_BEAR_P
{
    let s: u64 = (a as u64) + (b as u64);
    let p: u64 = BABY_BEAR_P as u64;
    let r: u64 = if s >= p { s - p } else { s };
    r as u32
}

// Subtraction mod P. Branchless via conditional add-P.
fn baby_bear_sub(a: u32, b: u32) -> u32
    requires a < BABY_BEAR_P
    requires b < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (a + BABY_BEAR_P - b) % BABY_BEAR_P
{
    let a64: u64 = a as u64;
    let b64: u64 = b as u64;
    let p: u64 = BABY_BEAR_P as u64;
    let r: u64 = if a64 >= b64 { a64 - b64 } else { a64 + p - b64 };
    r as u32
}

// Multiplication mod P via u64 intermediate.
// a, b < 2^31  =>  a*b < 2^62, fits safely in u64.
// Using modulo for provability; the C compiler reduces this to
// a constant-time Barrett/Montgomery sequence for GPU performance.
fn baby_bear_mul(a: u32, b: u32) -> u32
    requires a < BABY_BEAR_P
    requires b < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (a * b) % BABY_BEAR_P
{
    let prod: u64 = (a as u64) * (b as u64);
    let p: u64 = BABY_BEAR_P as u64;
    let r: u64 = prod % p;
    r as u32
}

// Negation mod P. Zero maps to zero.
fn baby_bear_neg(a: u32) -> u32
    requires a < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (BABY_BEAR_P - a) % BABY_BEAR_P
{
    if a == 0u32 { 0u32 } else { BABY_BEAR_P - a }
}

// Double mod P. Same cost as baby_bear_add(a, a) but avoids the second load.
fn baby_bear_double(a: u32) -> u32
    requires a < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (a + a) % BABY_BEAR_P
{
    baby_bear_add(a, a)
}

// Multiplication by W = 11 (the extension polynomial constant).
// Used in extension-field multiplication where a^4 = 11.
fn baby_bear_mul_w(a: u32) -> u32
    requires a < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (a * BABY_BEAR_W) % BABY_BEAR_P
{
    baby_bear_mul(a, BABY_BEAR_W)
}

// ---- BabyBear^4 = BabyBear[a]/(a^4 - W) extension --------------------------
// Element: (c0, c1, c2, c3), value = c0 + c1*a + c2*a^2 + c3*a^3.
//
// Multiplication of (a0+a1*a+a2*a^2+a3*a^3) and (b0+b1*a+b2*a^2+b3*a^3):
//   Let p_k = sum_{i+j=k} a_i*b_j for k in 0..7.
//   After reducing a^4=W, a^5=W*a, a^6=W*a^2, a^7=W*a^3:
//     c0 = p_0 + W*p_4
//     c1 = p_1 + W*p_5
//     c2 = p_2 + W*p_6
//     c3 = p_3 + W*p_7
//   Equivalently:
//     c0 = a0*b0 + W*(a1*b3 + a2*b2 + a3*b1)
//     c1 = a0*b1 + a1*b0 + W*(a2*b3 + a3*b2)
//     c2 = a0*b2 + a1*b1 + a2*b0 + W*(a3*b3)
//     c3 = a0*b3 + a1*b2 + a2*b1 + a3*b0

fn baby_bear_ext4_mul_c0(
    a0: u32, a1: u32, a2: u32, a3: u32,
    b0: u32, b1: u32, b2: u32, b3: u32) -> u32
    requires a0 < BABY_BEAR_P  requires a1 < BABY_BEAR_P
    requires a2 < BABY_BEAR_P  requires a3 < BABY_BEAR_P
    requires b0 < BABY_BEAR_P  requires b1 < BABY_BEAR_P
    requires b2 < BABY_BEAR_P  requires b3 < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (a0*b0 + BABY_BEAR_W*(a1*b3 + a2*b2 + a3*b1)) % BABY_BEAR_P
{
    let a0b0: u32 = baby_bear_mul(a0, b0);
    let a1b3: u32 = baby_bear_mul(a1, b3);
    let a2b2: u32 = baby_bear_mul(a2, b2);
    let a3b1: u32 = baby_bear_mul(a3, b1);
    let s1: u32 = baby_bear_add(a1b3, a2b2);
    let s2: u32 = baby_bear_add(s1, a3b1);
    let ws: u32 = baby_bear_mul_w(s2);
    assert((a0*b0 + BABY_BEAR_W*(a1*b3 + a2*b2 + a3*b1)) % BABY_BEAR_P
           == (a0b0 + ws) % BABY_BEAR_P) "ext4 c0 folds mod P";
    baby_bear_add(a0b0, ws)
}

fn baby_bear_ext4_mul_c1(
    a0: u32, a1: u32, a2: u32, a3: u32,
    b0: u32, b1: u32, b2: u32, b3: u32) -> u32
    requires a0 < BABY_BEAR_P  requires a1 < BABY_BEAR_P
    requires a2 < BABY_BEAR_P  requires a3 < BABY_BEAR_P
    requires b0 < BABY_BEAR_P  requires b1 < BABY_BEAR_P
    requires b2 < BABY_BEAR_P  requires b3 < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (a0*b1 + a1*b0 + BABY_BEAR_W*(a2*b3 + a3*b2)) % BABY_BEAR_P
{
    let a0b1: u32 = baby_bear_mul(a0, b1);
    let a1b0: u32 = baby_bear_mul(a1, b0);
    let a2b3: u32 = baby_bear_mul(a2, b3);
    let a3b2: u32 = baby_bear_mul(a3, b2);
    let s0: u32 = baby_bear_add(a0b1, a1b0);
    let s1: u32 = baby_bear_add(a2b3, a3b2);
    let ws: u32 = baby_bear_mul_w(s1);
    assert((a0*b1 + a1*b0 + BABY_BEAR_W*(a2*b3 + a3*b2)) % BABY_BEAR_P == (s0 + ws) % BABY_BEAR_P) "ext4 c1 folds mod P";
    baby_bear_add(s0, ws)
}

fn baby_bear_ext4_mul_c2(
    a0: u32, a1: u32, a2: u32, a3: u32,
    b0: u32, b1: u32, b2: u32, b3: u32) -> u32
    requires a0 < BABY_BEAR_P  requires a1 < BABY_BEAR_P
    requires a2 < BABY_BEAR_P  requires a3 < BABY_BEAR_P
    requires b0 < BABY_BEAR_P  requires b1 < BABY_BEAR_P
    requires b2 < BABY_BEAR_P  requires b3 < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (a0*b2 + a1*b1 + a2*b0 + BABY_BEAR_W*(a3*b3)) % BABY_BEAR_P
{
    let a0b2: u32 = baby_bear_mul(a0, b2);
    let a1b1: u32 = baby_bear_mul(a1, b1);
    let a2b0: u32 = baby_bear_mul(a2, b0);
    let a3b3: u32 = baby_bear_mul(a3, b3);
    let s01: u32 = baby_bear_add(a0b2, a1b1);
    let s012: u32 = baby_bear_add(s01, a2b0);
    let ws: u32 = baby_bear_mul_w(a3b3);
    assert((a0*b2 + a1*b1 + a2*b0 + BABY_BEAR_W*(a3*b3)) % BABY_BEAR_P == (s012 + ws) % BABY_BEAR_P) "ext4 c2 folds mod P";
    baby_bear_add(s012, ws)
}

fn baby_bear_ext4_mul_c3(
    a0: u32, a1: u32, a2: u32, a3: u32,
    b0: u32, b1: u32, b2: u32, b3: u32) -> u32
    requires a0 < BABY_BEAR_P  requires a1 < BABY_BEAR_P
    requires a2 < BABY_BEAR_P  requires a3 < BABY_BEAR_P
    requires b0 < BABY_BEAR_P  requires b1 < BABY_BEAR_P
    requires b2 < BABY_BEAR_P  requires b3 < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (a0*b3 + a1*b2 + a2*b1 + a3*b0) % BABY_BEAR_P
{
    let a0b3: u32 = baby_bear_mul(a0, b3);
    let a1b2: u32 = baby_bear_mul(a1, b2);
    let a2b1: u32 = baby_bear_mul(a2, b1);
    let a3b0: u32 = baby_bear_mul(a3, b0);
    let s01: u32 = baby_bear_add(a0b3, a1b2);
    let s012: u32 = baby_bear_add(s01, a2b1);
    assert((a0*b3 + a1*b2 + a2*b1 + a3*b0) % BABY_BEAR_P == (s012 + a3b0) % BABY_BEAR_P) "ext4 c3 folds mod P";
    baby_bear_add(s012, a3b0)
}

// ---- BabyBear^4 addition / subtraction (componentwise) ---------------------

fn baby_bear_ext4_add_c0(a: u32, b: u32) -> u32
    requires a < BABY_BEAR_P  requires b < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (a + b) % BABY_BEAR_P
{ baby_bear_add(a, b) }

fn baby_bear_ext4_add_c1(a: u32, b: u32) -> u32
    requires a < BABY_BEAR_P  requires b < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (a + b) % BABY_BEAR_P
{ baby_bear_add(a, b) }

fn baby_bear_ext4_add_c2(a: u32, b: u32) -> u32
    requires a < BABY_BEAR_P  requires b < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (a + b) % BABY_BEAR_P
{ baby_bear_add(a, b) }

fn baby_bear_ext4_add_c3(a: u32, b: u32) -> u32
    requires a < BABY_BEAR_P  requires b < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (a + b) % BABY_BEAR_P
{ baby_bear_add(a, b) }

fn baby_bear_ext4_sub_c0(a: u32, b: u32) -> u32
    requires a < BABY_BEAR_P  requires b < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (a + BABY_BEAR_P - b) % BABY_BEAR_P
{ baby_bear_sub(a, b) }

fn baby_bear_ext4_sub_c1(a: u32, b: u32) -> u32
    requires a < BABY_BEAR_P  requires b < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (a + BABY_BEAR_P - b) % BABY_BEAR_P
{ baby_bear_sub(a, b) }

fn baby_bear_ext4_sub_c2(a: u32, b: u32) -> u32
    requires a < BABY_BEAR_P  requires b < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (a + BABY_BEAR_P - b) % BABY_BEAR_P
{ baby_bear_sub(a, b) }

fn baby_bear_ext4_sub_c3(a: u32, b: u32) -> u32
    requires a < BABY_BEAR_P  requires b < BABY_BEAR_P
    ensures result < BABY_BEAR_P
    ensures result == (a + BABY_BEAR_P - b) % BABY_BEAR_P
{ baby_bear_sub(a, b) }

fn main() -> u64 { 0u64 }
