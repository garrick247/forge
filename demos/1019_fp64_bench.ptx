// FORGE-generated PTX — SM_120
// Proofs discharged before emission. Correct by construction.

.version 8.8
.target sm_120
.address_size 64

.visible .entry fp64_bench(
    .param .u64 fp64_bench_param_out_data,
    .param .u64 fp64_bench_param_out_len,
    .param .u64 fp64_bench_param_n_iters,
    .param .f64 fp64_bench_param_b,
    .param .f64 fp64_bench_param_c
)
{
    .reg .f64 %fd11, %fd12, %fd13, %fd14, %fd18, %fd19, %fd20, %fd21, %fd22, %fd23, %fd24, %fd25, %fd3, %fd31, %fd32, %fd33, %fd4;
    .reg .pred %p17, %p29;
    .reg .u32 %r28, %r37, %r38, %r39, %r5, %r6, %r7, %r8, %r9;
    .reg .u64 %rd0, %rd1, %rd10, %rd15, %rd2, %rd26, %rd27, %rd34, %rd35, %rd36;

  ld.param.u64 %rd0, [fp64_bench_param_out_data];
  ld.param.u64 %rd1, [fp64_bench_param_out_len];
  ld.param.u64 %rd2, [fp64_bench_param_n_iters];
  ld.param.f64 %fd3, [fp64_bench_param_b];
  ld.param.f64 %fd4, [fp64_bench_param_c];

  mov.u32 %r5, %ctaid.x;
  mov.u32 %r6, %ntid.x;
  mul.lo.u32 %r7, %r5, %r6;
  mov.u32 %r8, %tid.x;
  add.u32 %r9, %r7, %r8;
  cvt.u64.u32 %rd10, %r9;
  mov.f64 %fd11, 0d3FF0000000000000; // 1
  mov.f64 %fd12, 0d4000000000000000; // 2
  mov.f64 %fd13, 0d4008000000000000; // 3
  mov.f64 %fd14, 0d4010000000000000; // 4
  mov.u64 %rd15, 0;
  fp64_bench_loop_16:
  setp.lt.u64 %p17, %rd15, %rd2;
  @!%p17 bra fp64_bench_loop_end_16;
  mul.f64 %fd18, %fd11, %fd3;
  add.f64 %fd19, %fd18, %fd4;
  mul.f64 %fd20, %fd12, %fd3;
  add.f64 %fd21, %fd20, %fd4;
  mul.f64 %fd22, %fd13, %fd3;
  add.f64 %fd23, %fd22, %fd4;
  mul.f64 %fd24, %fd14, %fd3;
  add.f64 %fd25, %fd24, %fd4;
  mov.u64 %rd26, 1;
  add.u64 %rd27, %rd15, %rd26;
  mov.f64 %fd11, %fd19; // loop wb: a0
  mov.f64 %fd12, %fd21; // loop wb: a1
  mov.f64 %fd13, %fd23; // loop wb: a2
  mov.f64 %fd14, %fd25; // loop wb: a3
  mov.u64 %rd15, %rd27; // loop wb: i
  bra fp64_bench_loop_16;
  fp64_bench_loop_end_16:
  mov.u32 %r28, 0; // unit
  setp.lt.u64 %p29, %rd10, %rd1;
  @%p29 bra fp64_bench_then_30;
  bra fp64_bench_else_30;
  fp64_bench_then_30:
  add.f64 %fd31, %fd11, %fd12;
  add.f64 %fd32, %fd31, %fd13;
  add.f64 %fd33, %fd32, %fd14;
  mov.u64 %rd34, 8;
  mul.lo.u64 %rd35, %rd10, %rd34;
  add.u64 %rd36, %rd0, %rd35;
  st.global.f64 [%rd36], %fd33;
  mov.u32 %r37, 0; // unit
  mov.u32 %r38, %r37;
  bra fp64_bench_end_30;
  fp64_bench_else_30:
  mov.u32 %r38, 0; // no else branch
  fp64_bench_end_30:
  mov.u32 %r39, 0; // unit
  ret;
}

