// Benchmark kernel: N parallel BabyBear multiplications.
//
//   out[i] = a[i] * b[i]  in BabyBear  (for i in 0..n)
//
// Same shape as demos/1024_qm31_kernels.fg but on BabyBear.

use std::gpu;
use std::koala_bear;

fn koala_bear_get(arr: span<u32>, idx: u64) -> u32
    requires idx < arr.len
    requires forall k: u64, k < arr.len ==> arr[k] < KOALA_BEAR_P
    ensures result < KOALA_BEAR_P
{
    assert(arr[idx] < KOALA_BEAR_P) "forall k instantiated at idx";
    arr[idx]
}

#[kernel]
fn koala_bear_mul_kernel(
    out: span<u32>,
    a:   span<u32>,
    b:   span<u32>,
    n:   u64)
    requires n <= out.len
    requires n <= a.len
    requires n <= b.len
    requires forall k: u64, k < a.len ==> a[k] < KOALA_BEAR_P
    requires forall k: u64, k < b.len ==> b[k] < KOALA_BEAR_P
{
    let tid: u64 = blockIdx_x * blockDim_x + threadIdx_x;
    if tid < n {
        let av: u32 = koala_bear_get(a, tid);
        let bv: u32 = koala_bear_get(b, tid);
        out[tid] = koala_bear_mul(av, bv);
    }
}

fn main() -> u64 { 0u64 }
