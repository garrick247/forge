#[kernel]
fn baby_bear_fused_perm_factored_kernel(
    out:   span<u32>,
    state: span<u32>,
    n:     u64)
    requires n > 0
    requires 16 * n <= out.len
    requires 16 * n <= state.len
    requires forall k: u64, k < state.len ==> state[k] < BABY_BEAR_P
{
    let tid: u64 = blockIdx_x * blockDim_x + threadIdx_x;
    if tid < n {
        let base: u64 = 16u64 * tid;

        let s_00: u32 = baby_bear_get(state, base + 0u64);
        let s_01: u32 = baby_bear_get(state, base + 1u64);
        let s_02: u32 = baby_bear_get(state, base + 2u64);
        let s_03: u32 = baby_bear_get(state, base + 3u64);
        let s_04: u32 = baby_bear_get(state, base + 4u64);
        let s_05: u32 = baby_bear_get(state, base + 5u64);
        let s_06: u32 = baby_bear_get(state, base + 6u64);
        let s_07: u32 = baby_bear_get(state, base + 7u64);
        let s_08: u32 = baby_bear_get(state, base + 8u64);
        let s_09: u32 = baby_bear_get(state, base + 9u64);
        let s_10: u32 = baby_bear_get(state, base + 10u64);
        let s_11: u32 = baby_bear_get(state, base + 11u64);
        let s_12: u32 = baby_bear_get(state, base + 12u64);
        let s_13: u32 = baby_bear_get(state, base + 13u64);
        let s_14: u32 = baby_bear_get(state, base + 14u64);
        let s_15: u32 = baby_bear_get(state, base + 15u64);

        // Initial M_E.
        let ime_00: u32 = init_ME_out_00(s_00, s_01, s_02, s_03, s_04, s_05, s_06, s_07, s_08, s_09, s_10, s_11, s_12, s_13, s_14, s_15);
        let ime_01: u32 = init_ME_out_01(s_00, s_01, s_02, s_03, s_04, s_05, s_06, s_07, s_08, s_09, s_10, s_11, s_12, s_13, s_14, s_15);
        let ime_02: u32 = init_ME_out_02(s_00, s_01, s_02, s_03, s_04, s_05, s_06, s_07, s_08, s_09, s_10, s_11, s_12, s_13, s_14, s_15);
        let ime_03: u32 = init_ME_out_03(s_00, s_01, s_02, s_03, s_04, s_05, s_06, s_07, s_08, s_09, s_10, s_11, s_12, s_13, s_14, s_15);
        let ime_04: u32 = init_ME_out_04(s_00, s_01, s_02, s_03, s_04, s_05, s_06, s_07, s_08, s_09, s_10, s_11, s_12, s_13, s_14, s_15);
        let ime_05: u32 = init_ME_out_05(s_00, s_01, s_02, s_03, s_04, s_05, s_06, s_07, s_08, s_09, s_10, s_11, s_12, s_13, s_14, s_15);
        let ime_06: u32 = init_ME_out_06(s_00, s_01, s_02, s_03, s_04, s_05, s_06, s_07, s_08, s_09, s_10, s_11, s_12, s_13, s_14, s_15);
        let ime_07: u32 = init_ME_out_07(s_00, s_01, s_02, s_03, s_04, s_05, s_06, s_07, s_08, s_09, s_10, s_11, s_12, s_13, s_14, s_15);
        let ime_08: u32 = init_ME_out_08(s_00, s_01, s_02, s_03, s_04, s_05, s_06, s_07, s_08, s_09, s_10, s_11, s_12, s_13, s_14, s_15);
