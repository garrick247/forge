// Demo 1158: functionally-verified Poseidon2 MDS diffusion layer (width 3)
//
// A Poseidon2 permutation round is: add round constants (linear) -> S-box x^5
// (nonlinear) -> MDS matrix multiply (linear diffusion). This demo functionally
// verifies the MDS layer for the width-3 external matrix circ(2,1,1):
//     [[2,1,1],[1,2,1],[1,1,2]]   so   out_i = 2*s_i + sum_{j != i} s_j  (mod P).
// Each output is proved to equal its exact field value, composed from the
// verified m31_double / m31_add.
//
// Scope note: the round's S-box (x^5 mod P) is NOT functionally verified here --
// its exact value is a high-degree nonlinear goal beyond automated Z3 (it fails
// even at a 300s per-obligation budget), the same Fermat-class limitation as the
// felt252 modular inverse (an audit-assume in that stack). The S-box is
// range-verified (result < P); the LINEAR layers (add-RC, MDS) are the
// functionally-verifiable part of the permutation, which this demo establishes.

use std::gpu;
use std::m31;

// out0 = 2*s0 + s1 + s2  (mod P)
fn poseidon2_mds3_out0(s0: u32, s1: u32, s2: u32) -> u32
    requires s0 < M31_P  requires s1 < M31_P  requires s2 < M31_P
    ensures result < M31_P
    ensures result == (2*s0 + s1 + s2) % M31_P
{
    let d: u32 = m31_double(s0);        // 2*s0 % P
    let t: u32 = m31_add(s1, s2);       // (s1 + s2) % P
    assert((2*s0 + s1 + s2) % M31_P == (d + t) % M31_P) "mds row0 folds mod P";
    m31_add(d, t)
}

// out1 = s0 + 2*s1 + s2  (mod P)
fn poseidon2_mds3_out1(s0: u32, s1: u32, s2: u32) -> u32
    requires s0 < M31_P  requires s1 < M31_P  requires s2 < M31_P
    ensures result < M31_P
    ensures result == (s0 + 2*s1 + s2) % M31_P
{
    let d: u32 = m31_double(s1);        // 2*s1 % P
    let t: u32 = m31_add(s0, s2);       // (s0 + s2) % P
    assert((s0 + 2*s1 + s2) % M31_P == (d + t) % M31_P) "mds row1 folds mod P";
    m31_add(d, t)
}

// out2 = s0 + s1 + 2*s2  (mod P)
fn poseidon2_mds3_out2(s0: u32, s1: u32, s2: u32) -> u32
    requires s0 < M31_P  requires s1 < M31_P  requires s2 < M31_P
    ensures result < M31_P
    ensures result == (s0 + s1 + 2*s2) % M31_P
{
    let d: u32 = m31_double(s2);        // 2*s2 % P
    let t: u32 = m31_add(s0, s1);       // (s0 + s1) % P
    assert((s0 + s1 + 2*s2) % M31_P == (d + t) % M31_P) "mds row2 folds mod P";
    m31_add(d, t)
}

// Add-round-constant layer (per element), functionally verified.
fn poseidon2_add_rc(s: u32, rc: u32) -> u32
    requires s < M31_P  requires rc < M31_P
    ensures result < M31_P
    ensures result == (s + rc) % M31_P
{
    m31_add(s, rc)
}

// In-place Poseidon2 MDS diffusion KERNEL (width-3 states, one thread per state).
// Applies the circ(2,1,1) MDS to state[3*tid .. 3*tid+2] in place, proving the
// exact array post-state (each slot = its MDS output over the OLD triple) + a
// frame. All three outputs depend on all three inputs, so the reads are taken
// before any write; the emitted __global__ kernel is a verified Poseidon2
// diffusion stage.
#[kernel]
fn poseidon2_mds3_at(state: span<u32>, n: u64, tid: u64)
    requires tid < n
    requires 3u64 * n <= state.len
    requires forall k: u64, k < state.len ==> state[k] < M31_P
    ensures state[3u64 * tid + 0u64] < M31_P
    ensures state[3u64 * tid + 1u64] < M31_P
    ensures state[3u64 * tid + 2u64] < M31_P
    ensures state[3u64 * tid + 0u64]
            == (2*old(state[3u64*tid + 0u64]) + old(state[3u64*tid + 1u64]) + old(state[3u64*tid + 2u64])) % M31_P
    ensures state[3u64 * tid + 1u64]
            == (old(state[3u64*tid + 0u64]) + 2*old(state[3u64*tid + 1u64]) + old(state[3u64*tid + 2u64])) % M31_P
    ensures state[3u64 * tid + 2u64]
            == (old(state[3u64*tid + 0u64]) + old(state[3u64*tid + 1u64]) + 2*old(state[3u64*tid + 2u64])) % M31_P
    ensures forall k: u64, k < state.len ==> k != 3u64*tid + 0u64 ==> k != 3u64*tid + 1u64
                                        ==> k != 3u64*tid + 2u64 ==> state[k] == old(state[k])
{
    let base: u64 = 3u64 * tid;
    assert(base + 2u64 < state.len) "state triple in bounds";
    assert(state[base + 0u64] < M31_P) "field @ base";
    assert(state[base + 1u64] < M31_P) "field @ base+1";
    assert(state[base + 2u64] < M31_P) "field @ base+2";
    let s0: u32 = state[base + 0u64];
    let s1: u32 = state[base + 1u64];
    let s2: u32 = state[base + 2u64];
    let o0: u32 = poseidon2_mds3_out0(s0, s1, s2);   // (2*s0 + s1 + s2) % P
    let o1: u32 = poseidon2_mds3_out1(s0, s1, s2);   // (s0 + 2*s1 + s2) % P
    let o2: u32 = poseidon2_mds3_out2(s0, s1, s2);   // (s0 + s1 + 2*s2) % P
    assert(base + 0u64 != base + 1u64) "distinct 0,1";
    assert(base + 0u64 != base + 2u64) "distinct 0,2";
    assert(base + 1u64 != base + 2u64) "distinct 1,2";
    state[base + 0u64] = o0;
    state[base + 1u64] = o1;
    state[base + 2u64] = o2;
    assert(state[base + 0u64] == o0) "slot 0 holds o0 after later distinct stores";
    assert(state[base + 1u64] == o1) "slot 1 holds o1 after later distinct store";
    assert(state[base + 2u64] == o2) "slot 2 holds o2";
}

// In-place add-round-constant KERNEL (width-3 states, one thread per state).
// state[3*tid + j] += rc[j]  (mod P). The first linear layer of a Poseidon2 round
// (before the S-box). Proves the exact array post-state + frame.
#[kernel]
fn poseidon2_add_rc_at(state: span<u32>, rc: span<u32>, n: u64, tid: u64)
    requires tid < n
    requires 3u64 * n <= state.len
    requires 3u64 <= rc.len
    requires forall k: u64, k < state.len ==> state[k] < M31_P
    requires forall k: u64, k < rc.len    ==> rc[k]    < M31_P
    ensures state[3u64 * tid + 0u64] < M31_P
    ensures state[3u64 * tid + 1u64] < M31_P
    ensures state[3u64 * tid + 2u64] < M31_P
    ensures state[3u64 * tid + 0u64] == (old(state[3u64*tid + 0u64]) + rc[0u64]) % M31_P
    ensures state[3u64 * tid + 1u64] == (old(state[3u64*tid + 1u64]) + rc[1u64]) % M31_P
    ensures state[3u64 * tid + 2u64] == (old(state[3u64*tid + 2u64]) + rc[2u64]) % M31_P
    ensures forall k: u64, k < state.len ==> k != 3u64*tid + 0u64 ==> k != 3u64*tid + 1u64
                                        ==> k != 3u64*tid + 2u64 ==> state[k] == old(state[k])
{
    let base: u64 = 3u64 * tid;
    assert(base + 2u64 < state.len) "state triple in bounds";
    assert(state[base + 0u64] < M31_P) "field @ base";
    assert(state[base + 1u64] < M31_P) "field @ base+1";
    assert(state[base + 2u64] < M31_P) "field @ base+2";
    assert(rc[0u64] < M31_P) "rc0 in range";
    assert(rc[1u64] < M31_P) "rc1 in range";
    assert(rc[2u64] < M31_P) "rc2 in range";
    let s0: u32 = state[base + 0u64];
    let s1: u32 = state[base + 1u64];
    let s2: u32 = state[base + 2u64];
    let o0: u32 = m31_add(s0, rc[0u64]);   // (s0 + rc0) % P
    let o1: u32 = m31_add(s1, rc[1u64]);
    let o2: u32 = m31_add(s2, rc[2u64]);
    assert(base + 0u64 != base + 1u64) "distinct 0,1";
    assert(base + 0u64 != base + 2u64) "distinct 0,2";
    assert(base + 1u64 != base + 2u64) "distinct 1,2";
    state[base + 0u64] = o0;
    state[base + 1u64] = o1;
    state[base + 2u64] = o2;
    assert(state[base + 0u64] == o0) "slot 0 holds o0";
    assert(state[base + 1u64] == o1) "slot 1 holds o1";
    assert(state[base + 2u64] == o2) "slot 2 holds o2";
}

fn main() -> u64 { 0u64 }
