// FORGE Demo 2014 — Opt-in overflow checking with #[checked]
//
// By default, Forge arithmetic wraps (C/CUDA semantics) and proofs run over
// mathematical integers — so `a + b >= a` is provable even though it can wrap.
// That default is required by the field/crypto corpus, which relies on wraparound.
//
// When the *magnitude* of a result matters for safety (allocation sizes, byte
// counts, offsets), annotate the function `#[checked]`. Forge then emits a
// no-overflow obligation for every unsigned + - * and discharges it in bitvector
// mode, where wraparound is modelled exactly. The obligations are dischargeable
// here because the preconditions bound the operands.
//
// See SOUNDNESS.md section 2 for the full semantics.

// A safe buffer-size computation: count * stride must not overflow, so a caller
// cannot trick it into returning a tiny size that wraps past a huge allocation.
#[checked]
fn buffer_size(count: u64, stride: u64) -> u64
    requires count  >= 1u64
    requires count  <= 1048576u64     // <= 2^20 elements
    requires stride >= 1u64
    requires stride <= 4096u64        // <= 2^12 bytes each
    ensures  result >= count          // stride >= 1, so product dominates the count
    ensures  result >= stride         // count  >= 1, so product dominates the stride
{
    count * stride
}

// Safe accumulation: header + payload can't overflow a u64 length field.
#[checked]
fn frame_len(header: u64, payload: u64) -> u64
    requires header  <= 65535u64
    requires payload <= 65535u64
    ensures  result >= header
    ensures  result >= payload
{
    header + payload
}

// Safe subtraction: remaining space is non-wrapping because used <= capacity.
#[checked]
fn remaining(capacity: u64, used: u64) -> u64
    requires used <= capacity
    ensures  result <= capacity
{
    capacity - used
}


// --- signed + shift: #[checked] covers these too (BV-mode exact) ---

// Signed sum, bounded so it cannot overflow i32 (sign-bit overflow test).
#[checked]
fn signed_sum(a: i32, b: i32) -> i32
    requires a >= -1000000i32
    requires a <= 1000000i32
    requires b >= -1000000i32
    requires b <= 1000000i32
{
    a + b
}

// Signed product across all sign quadrants, bounded to fit i32.
#[checked]
fn signed_scale(a: i32, b: i32) -> i32
    requires a >= -30000i32
    requires a <= 30000i32
    requires b >= -30000i32
    requires b <= 30000i32
{
    a * b
}

// Bit-packing shift: proven to drop no high bits (k < 32 and round-trips).
#[checked]
fn pack_shift(a: u32, k: u32) -> u32
    requires a <= 65535u32
    requires k <= 16u32
{
    a << k
}


// --- signed * and << by a LITERAL constant ---
// When a multiplier or shift amount is a compile-time constant, Forge emits an
// exact constant-folded bound (the representable interval for the other operand)
// instead of the general sign-split. This is sound AND complete — the bound is
// tight at the INT_MIN/INT_MAX edge — and avoids the literal/literal division
// that previously left these obligations undischargeable.

// Scale by a positive literal.
#[checked]
fn double_signed(a: i32) -> i32
    requires a >= -1000000000i32
    requires a <= 1000000000i32
{
    a * 2i32
}

// Scale by a negative literal (the sign-split corner the general path handles,
// here exact via the folded bound).
#[checked]
fn triple_negate(a: i32) -> i32
    requires a >= -700000000i32
    requires a <= 700000000i32
{
    a * -3i32
}

// Negate via * -1: rejected only at a == INT_MIN, accepted on the rest.
#[checked]
fn negate_via_mul(a: i32) -> i32
    requires a >= -2147483647i32
{
    a * -1i32
}

// Left shift by a literal amount: proven to drop no significant bits.
#[checked]
fn shift_signed_lit(a: i32) -> i32
    requires a >= 0i32
    requires a <= 2000000i32
{
    a << 10i32
}
