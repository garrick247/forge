// Demo 1154: functionally-verified FRI folding layer
//
// FRI (the low-degree test at the heart of STARK proving) folds an evaluation
// vector's two halves with a verifier challenge alpha:
//     new[i] = old[i] + alpha * old[i + half]        (mod P)          -- fold
//     new[i] = old[i] - alpha * old[i + half]        (mod P)          -- unfold (inverse)
// The kernels in demo 1022 prove memory-safety + canonical range for this step.
// This demo proves the FUNCTIONAL post-state: after the write, new_evals[i] holds
// the EXACT field value old[i] +/- alpha*old[i+half], and every other output slot
// is untouched. It lifts the M31 field-tower functional correctness up through the
// FRI fold kernel (cf. demo 1153 for the NTT butterfly).
//
// Uses tid as an explicit thread index (SPMD kernel model, cf. demo 232) and
// old(span[i]) pre-state references (cf. demo 139).

use std::gpu;
use std::m31;

#[kernel]
fn fri_fold_at(new_evals: span<u32>, old_evals: span<u32>, alpha: u32, half: u64, i: u64)
    requires i < half
    requires half + half <= old_evals.len
    requires half <= new_evals.len
    requires alpha < M31_P
    requires forall k: u64, k < old_evals.len ==> old_evals[k] < M31_P
    ensures new_evals[i] < M31_P
    ensures new_evals[i] == (old(old_evals[i]) + alpha * old(old_evals[i + half])) % M31_P
    ensures forall k: u64, k < new_evals.len ==> k != i ==> new_evals[k] == old(new_evals[k])
{
    assert(i < old_evals.len) "i in bounds";
    assert(i + half < old_evals.len) "i+half in bounds";
    assert(old_evals[i] < M31_P) "field invariant at i";
    assert(old_evals[i + half] < M31_P) "field invariant at i+half";
    let a: u32 = old_evals[i];
    let b: u32 = old_evals[i + half];
    // old_evals is read-only here, so the reads equal the pre-state snapshot
    assert(a == old(old_evals[i])) "a is the pre-state old_evals[i]";
    assert(b == old(old_evals[i + half])) "b is the pre-state old_evals[i+half]";
    let ab: u32 = m31_mul(alpha, b);            // ab == (alpha*b) % P
    // fold: (a + alpha*b) == (a + ab)  (mod P)
    assert((a + alpha * b) % M31_P == (a + ab) % M31_P) "challenge product folds mod P";
    new_evals[i] = m31_add(a, ab);
}

#[kernel]
fn fri_unfold_at(new_evals: span<u32>, old_evals: span<u32>, alpha: u32, half: u64, i: u64)
    requires i < half
    requires half + half <= old_evals.len
    requires half <= new_evals.len
    requires alpha < M31_P
    requires forall k: u64, k < old_evals.len ==> old_evals[k] < M31_P
    ensures new_evals[i] < M31_P
    ensures new_evals[i]
            == (old(old_evals[i]) + M31_P - (alpha * old(old_evals[i + half])) % M31_P) % M31_P
    ensures forall k: u64, k < new_evals.len ==> k != i ==> new_evals[k] == old(new_evals[k])
{
    assert(i < old_evals.len) "i in bounds";
    assert(i + half < old_evals.len) "i+half in bounds";
    assert(old_evals[i] < M31_P) "field invariant at i";
    assert(old_evals[i + half] < M31_P) "field invariant at i+half";
    let a: u32 = old_evals[i];
    let b: u32 = old_evals[i + half];
    // old_evals is read-only here, so the reads equal the pre-state snapshot
    assert(a == old(old_evals[i])) "a is the pre-state old_evals[i]";
    assert(b == old(old_evals[i + half])) "b is the pre-state old_evals[i+half]";
    let ab: u32 = m31_mul(alpha, b);            // ab == (alpha*b) % P
    new_evals[i] = m31_sub(a, ab);              // == (a + P - ab) % P  (matches ensures by substitution)
}

// CM31 (complex extension) FRI fold — the fold stwo actually runs, over CM31:
//   new[i] = old[i] + alpha * old[i+half]   with alpha, old, new all in CM31.
#[kernel]
fn fri_fold_at_cm31(new_re: span<u32>, new_im: span<u32>,
                    old_re: span<u32>, old_im: span<u32>,
                    alpha_re: u32, alpha_im: u32, half: u64, i: u64)
    requires i < half
    requires half + half <= old_re.len
    requires half + half <= old_im.len
    requires half <= new_re.len
    requires half <= new_im.len
    requires alpha_re < M31_P
    requires alpha_im < M31_P
    requires forall k: u64, k < old_re.len ==> old_re[k] < M31_P
    requires forall k: u64, k < old_im.len ==> old_im[k] < M31_P
    ensures new_re[i] < M31_P
    ensures new_im[i] < M31_P
    ensures new_re[i]
            == (old(old_re[i]) + alpha_re*old(old_re[i+half])
                + M31_P*M31_P - alpha_im*old(old_im[i+half])) % M31_P
    ensures new_im[i]
            == (old(old_im[i]) + alpha_re*old(old_im[i+half])
                + alpha_im*old(old_re[i+half])) % M31_P
    ensures forall k: u64, k < new_re.len ==> k != i ==> new_re[k] == old(new_re[k])
    ensures forall k: u64, k < new_im.len ==> k != i ==> new_im[k] == old(new_im[k])
{
    assert(i < old_re.len) "i re-bounds";
    assert(i + half < old_re.len) "i+half re-bounds";
    assert(i < old_im.len) "i im-bounds";
    assert(i + half < old_im.len) "i+half im-bounds";
    assert(old_re[i] < M31_P) "field re@i";
    assert(old_re[i + half] < M31_P) "field re@i+half";
    assert(old_im[i] < M31_P) "field im@i";
    assert(old_im[i + half] < M31_P) "field im@i+half";
    let a_re: u32 = old_re[i];
    let a_im: u32 = old_im[i];
    let b_re: u32 = old_re[i + half];
    let b_im: u32 = old_im[i + half];
    assert(a_re == old(old_re[i])) "a_re pre-state";
    assert(a_im == old(old_im[i])) "a_im pre-state";
    assert(b_re == old(old_re[i + half])) "b_re pre-state";
    assert(b_im == old(old_im[i + half])) "b_im pre-state";
    let ab_re: u32 = cm31_mul_re(alpha_re, alpha_im, b_re, b_im);
    let ab_im: u32 = cm31_mul_im(alpha_re, alpha_im, b_re, b_im);
    assert((a_re + alpha_re*b_re + M31_P*M31_P - alpha_im*b_im) % M31_P
           == (a_re + ab_re) % M31_P) "cm31 fold re folds mod P";
    assert((a_im + alpha_re*b_im + alpha_im*b_re) % M31_P
           == (a_im + ab_im) % M31_P) "cm31 fold im folds mod P";
    new_re[i] = m31_add(a_re, ab_re);
    new_im[i] = m31_add(a_im, ab_im);
}

fn main() -> u64 { 0u64 }
