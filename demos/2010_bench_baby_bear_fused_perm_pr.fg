#[kernel]
fn baby_bear_fused_perm_pr_kernel(
    out:   span<u32>,
    state: span<u32>,
    n:     u64)
    requires n > 0
    requires 16 * n <= out.len
    requires 16 * n <= state.len
    requires forall k: u64, k < state.len ==> state[k] < BABY_BEAR_P
{
    let tid: u64 = blockIdx_x * blockDim_x + threadIdx_x;
    if tid < n {
        let base: u64 = 16u64 * tid;
        copy_state_window(out, state, base);
        apply_init_ME(out, base);
        apply_ext_round_init_0(out, base);
        apply_ext_round_init_1(out, base);
        apply_ext_round_init_2(out, base);
        apply_ext_round_init_3(out, base);
        apply_partial_round_00(out, base);
        apply_partial_round_01(out, base);
        apply_partial_round_02(out, base);
        apply_partial_round_03(out, base);
        apply_partial_round_04(out, base);
        apply_partial_round_05(out, base);
        apply_partial_round_06(out, base);
        apply_partial_round_07(out, base);
        apply_partial_round_08(out, base);
        apply_partial_round_09(out, base);
        apply_partial_round_10(out, base);
        apply_partial_round_11(out, base);
        apply_partial_round_12(out, base);
        apply_ext_round_final_0(out, base);
        apply_ext_round_final_1(out, base);
        apply_ext_round_final_2(out, base);
        apply_ext_round_final_3(out, base);
    }
}

fn main() -> u64 { 0u64 }
