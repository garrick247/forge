// VortexSTARK eval_at_point fold kernels — FORGE.
// Replaces cuda/circle_ntt.cu fold_first_level_kernel + fold_level_kernel,
// the folding reduction behind PolyOps::eval_at_point. result[i] = a + factor*b.
// QM31 = 4 u32 INTERLEAVED (element i at i*4..i*4+3) to match CUDA layout.

use std::gpu;
use std::m31;

#[device]
fn reduce_word(v: u32) -> u32
    ensures result < M31_P
{
    let lo: u32 = v & M31_P;
    let hi: u32 = v >> 31u32;
    let r: u32 = lo + hi;
    if r >= M31_P { r - M31_P } else { r }
}

#[kernel]
fn eval_fold_first(
    coeffs: span<u32>,
    out: span<u32>,
    fa: u32, fb: u32, fc: u32, fd: u32,
    half_n: u64
)
    requires fa < M31_P
    requires fb < M31_P
    requires fc < M31_P
    requires fd < M31_P
    requires half_n * 2u64 <= coeffs.len
    requires half_n * 4u64 <= out.len
{
    let i: u64 = blockIdx_x * blockDim_x + threadIdx_x;
    if i < half_n {
        let bi: u64 = i + half_n;
        let o3: u64 = i * 4u64 + 3u64;
        if bi < coeffs.len {
            if o3 < out.len {
                let a: u32 = reduce_word(coeffs[i]);
                let b: u32 = reduce_word(coeffs[bi]);
                let bf0: u32 = m31_mul(fa, b);
                let bf1: u32 = m31_mul(fb, b);
                let bf2: u32 = m31_mul(fc, b);
                let bf3: u32 = m31_mul(fd, b);
                out[i * 4u64 + 0u64] = m31_add(a, bf0);
                out[i * 4u64 + 1u64] = bf1;
                out[i * 4u64 + 2u64] = bf2;
                out[i * 4u64 + 3u64] = bf3;
            };
        };
    };
}

#[kernel]
fn eval_fold_level(
    in_data: span<u32>,
    out_data: span<u32>,
    fa: u32, fb: u32, fc: u32, fd: u32,
    half_n: u64
)
    requires fa < M31_P
    requires fb < M31_P
    requires fc < M31_P
    requires fd < M31_P
    requires half_n * 8u64 <= in_data.len
    requires half_n * 4u64 <= out_data.len
{
    let i: u64 = blockIdx_x * blockDim_x + threadIdx_x;
    if i < half_n {
        let ai: u64 = i * 4u64;
        let bi: u64 = (i + half_n) * 4u64;
        let a3: u64 = ai + 3u64;
        let b3: u64 = bi + 3u64;
        if a3 < in_data.len {
            if b3 < in_data.len {
                if a3 < out_data.len {
                    let a0: u32 = reduce_word(in_data[ai + 0u64]);
                    let a1: u32 = reduce_word(in_data[ai + 1u64]);
                    let a2: u32 = reduce_word(in_data[ai + 2u64]);
                    let a3v: u32 = reduce_word(in_data[ai + 3u64]);
                    let b0: u32 = reduce_word(in_data[bi + 0u64]);
                    let b1: u32 = reduce_word(in_data[bi + 1u64]);
                    let b2: u32 = reduce_word(in_data[bi + 2u64]);
                    let b3v: u32 = reduce_word(in_data[bi + 3u64]);
                    let p0: u32 = qm31_mul_out_re_re(fa, fb, fc, fd, b0, b1, b2, b3v);
                    let p1: u32 = qm31_mul_out_re_im(fa, fb, fc, fd, b0, b1, b2, b3v);
                    let p2: u32 = qm31_mul_out_im_re(fa, fb, fc, fd, b0, b1, b2, b3v);
                    let p3: u32 = qm31_mul_out_im_im(fa, fb, fc, fd, b0, b1, b2, b3v);
                    out_data[ai + 0u64] = qm31_add_re_re(a0, p0);
                    out_data[ai + 1u64] = qm31_add_re_im(a1, p1);
                    out_data[ai + 2u64] = qm31_add_im_re(a2, p2);
                    out_data[ai + 3u64] = qm31_add_im_im(a3v, p3);
                };
            };
        };
    };
}

fn main() -> u64 { 0u64 }
